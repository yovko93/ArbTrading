<UserControl x:Class="Arbitrage.Desktop.Views.PaperAnalyticsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="clr-namespace:Arbitrage.Desktop.Views"
 xmlns:controls="clr-namespace:Arbitrage.Desktop.Controls">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
  <ResourceDictionary Source="/Arbitrage.Desktop;component/Resources/Styles/MarketWorkflow.xaml"/>
 </ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel>
   <controls:SectionHeader Title="Analytics" Subtitle="Read-only paper capital, performance, executable valuation, and reliability summary."/>
   <WrapPanel Margin="0,0,0,12"><controls:StatusBadge Label="PAPER SUMMARY" Tone="Info" Margin="0,0,12,8"/><Button Content="Refresh summary" Command="{Binding RefreshCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,0,0,8" AutomationProperties.Name="Refresh paper analytics summary"/></WrapPanel>
   <Border Style="{StaticResource WorkflowNotice}" ToolTip="{Binding Notice}"><TextBlock Text="{Binding Notice}" TextWrapping="Wrap"/></Border>
   <Border Style="{StaticResource WorkflowCard}" AutomationProperties.AutomationId="AnalyticsGeneration"><StackPanel>
    <TextBlock Text="Paper generation" Style="{StaticResource SectionTitleText}"/>
    <WrapPanel Margin="0,10,0,4">
     <Border Style="{StaticResource WorkflowMetric}"><StackPanel><TextBlock Text="ACCOUNT" Style="{StaticResource EyebrowText}"/><controls:StatusBadge Label="{Binding Account.State, TargetNullValue=Unavailable, FallbackValue=Unavailable}" Style="{StaticResource WorkflowState}" Margin="0,6,0,0"/></StackPanel></Border>
     <Border Style="{StaticResource WorkflowMetric}"><StackPanel><TextBlock Text="INTEGRITY" Style="{StaticResource EyebrowText}"/><controls:StatusBadge Label="{Binding Account.Generation.Integrity, TargetNullValue=Unavailable, FallbackValue=Unavailable}" Style="{StaticResource WorkflowState}" Margin="0,6,0,0"/></StackPanel></Border>
     <Border Style="{StaticResource WorkflowMetric}"><StackPanel><TextBlock Text="VALUATION" Style="{StaticResource EyebrowText}"/><controls:StatusBadge Label="{Binding Valuation.State, TargetNullValue=Unavailable, FallbackValue=Unavailable}" Style="{StaticResource WorkflowState}" Margin="0,6,0,0"/></StackPanel></Border>
    </WrapPanel>
    <TextBlock Text="{Binding GenerationSummary}" TextWrapping="Wrap" Margin="0,0,0,6"/>
    <TextBlock Text="{Binding ExecutionSummary}" TextWrapping="Wrap" Style="{StaticResource MutedText}"/>
   </StackPanel></Border>
   <Border Style="{StaticResource WorkflowCard}" AutomationProperties.AutomationId="AnalyticsCapital"><StackPanel>
    <TextBlock Text="Capital and realized performance" Style="{StaticResource SectionTitleText}"/>
    <TextBlock Text="Each row is one venue and currency. Monetary values are never combined across currencies." TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,6,0,10"/>
<DataGrid ItemsSource="{Binding Buckets}" AutomationProperties.Name="Paper analytics capital by venue and currency" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Venue" Binding="{Binding Exchange}" Width="120" />
              <DataGridTextColumn Header="Currency" Binding="{Binding Currency}" Width="90" />
              <DataGridTextColumn Header="Starting cash" Binding="{Binding StartingCash, StringFormat=N2}" Width="110" />
              <DataGridTextColumn Header="Current cash" Binding="{Binding CurrentCash, StringFormat=N2}" Width="110" />
              <DataGridTextColumn Header="Open cost" Binding="{Binding OpenCostBasis, StringFormat=N2}" Width="105" />
              <DataGridTextColumn Header="Realized P&amp;L" Binding="{Binding RealizedPnl, StringFormat=N2}" Width="110" />
              <DataGridTextColumn Header="Open positions" Binding="{Binding OpenPositions}" Width="125" />
              <DataGridTextColumn Header="Settled positions" Binding="{Binding SettledPositions}" Width="135" />
            </DataGrid.Columns>
          </DataGrid><Border AutomationProperties.AutomationId="AnalyticsCapitalEmpty"><Border.Style><Style TargetType="Border" BasedOn="{StaticResource WorkflowEmpty}"><Style.Triggers><DataTrigger Binding="{Binding Buckets.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="Capital and realized performance unavailable. No venue/currency summary is currently exposed." TextWrapping="Wrap" Style="{StaticResource MutedText}"/></Border>
   </StackPanel></Border>
   <Border Style="{StaticResource WorkflowCard}" AutomationProperties.AutomationId="AnalyticsValuation"><StackPanel>
    <TextBlock Text="Executable valuation" Style="{StaticResource SectionTitleText}"/>
    <TextBlock Text="{Binding ValuationSummary}" TextWrapping="Wrap" Margin="0,8,0,10"/>
<DataGrid ItemsSource="{Binding Buckets}" AutomationProperties.Name="Paper analytics executable valuation by venue and currency" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Venue" Binding="{Binding Exchange}" Width="120" />
              <DataGridTextColumn Header="Currency" Binding="{Binding Currency}" Width="85" />
              <DataGridTextColumn Header="Book value" Binding="{Binding AccountingBookValue, TargetNullValue=Unavailable, StringFormat=N2}" Width="100" />
              <DataGridTextColumn Header="Gross equity" Binding="{Binding GrossMarkedEquity, TargetNullValue=Unavailable, StringFormat=N2}" Width="100" />
              <DataGridTextColumn Header="Fee-adjusted equity" Binding="{Binding FeeAdjustedMarkedEquity, TargetNullValue=Unavailable, StringFormat=N2}" Width="165" />
              <DataGridTextColumn Header="Gross unrealized" Binding="{Binding GrossUnrealizedPnl, TargetNullValue=Unavailable, StringFormat=N2}" Width="140" />
              <DataGridTextColumn Header="Fee-adjusted unrealized" Binding="{Binding FeeAdjustedUnrealizedPnl, TargetNullValue=Unavailable, StringFormat=N2}" Width="185" />
              <DataGridTextColumn Header="Coverage" Binding="{Binding Coverage}" Width="180" />
            </DataGrid.Columns>
          </DataGrid><Border AutomationProperties.AutomationId="AnalyticsValuationEmpty"><Border.Style><Style TargetType="Border" BasedOn="{StaticResource WorkflowEmpty}"><Style.Triggers><DataTrigger Binding="{Binding Buckets.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="Executable valuation unavailable. No venue/currency valuation rows are currently exposed." TextWrapping="Wrap" Style="{StaticResource MutedText}"/></Border>
    <Border Style="{StaticResource InsetPanel}" Padding="12" Margin="0,10,0,0"><TextBlock Text="Unrealized values are derived from API total P&amp;L minus realized P&amp;L only when full totals are available. See Portfolio for position-level marks and settlement." Style="{StaticResource MutedText}" TextWrapping="Wrap"/></Border>
   </StackPanel></Border>
   <Border Style="{StaticResource WorkflowCard}" AutomationProperties.AutomationId="AnalyticsReliability"><StackPanel>
    <TextBlock Text="Paper Reliability" Style="{StaticResource SectionTitleText}"/>
    <WrapPanel Margin="0,10,0,4"><controls:StatusBadge Label="{Binding Reliability.Campaign.State, TargetNullValue=NoActiveCampaign, FallbackValue=NoActiveCampaign}" Style="{StaticResource WorkflowState}" Margin="0,0,8,8"/><controls:StatusBadge Label="{Binding Reliability.Report.State, TargetNullValue=Not evaluated, FallbackValue=Not evaluated}" Style="{StaticResource WorkflowState}" Margin="0,0,0,8"/></WrapPanel>
    <TextBlock Text="{Binding ReliabilitySummary}" TextWrapping="Wrap" Margin="0,0,0,6"/>
    <TextBlock Text="{Binding ReliabilityRuntime}" TextWrapping="Wrap"/>
    <TextBlock Text="Open Paper Reliability for the full evidence report and campaign controls. Paper evidence does not enable live trading." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,10,0,0"/>
   </StackPanel></Border>
  </StackPanel>
 </ScrollViewer>
</UserControl>
