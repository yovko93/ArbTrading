<Window x:Class="Arbitrage.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Arbitrage Trading — Local foundation" Width="800" Height="660" MinWidth="620" MinHeight="550">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="28">
      <TextBlock Text="Arbitrage Trading" FontSize="28" FontWeight="SemiBold" />
      <TextBlock Text="Phase 01A · Local foundation" Margin="0,4,0,24" />
      <DockPanel>
        <Button Content="Refresh" Command="{Binding RefreshCommand}" DockPanel.Dock="Right" Padding="18,7" />
        <TextBlock Text="{Binding ConnectionStatus}" FontSize="20" VerticalAlignment="Center" />
      </DockPanel>
      <ProgressBar Height="3" Margin="0,10" IsIndeterminate="{Binding IsBusy}" />
      <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,0,0,20" />
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="32" /><RowDefinition Height="32" /><RowDefinition Height="32" />
          <RowDefinition Height="32" /><RowDefinition Height="32" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Backend version" /><TextBlock Grid.Column="1" Text="{Binding BackendVersion}" />
        <TextBlock Grid.Row="1" Text="Local user" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding UserId}" />
        <TextBlock Grid.Row="2" Text="Workspace ID" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding WorkspaceIdentifier}" />
        <TextBlock Grid.Row="3" Text="Persistence" /><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Persistence}" />
        <TextBlock Grid.Row="4" Text="Effective environment" /><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding TradingMode}" />
        <TextBlock Grid.Row="5" Text="Execution" /><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Execution}" TextWrapping="Wrap" Margin="0,0,0,12" />
        <TextBlock Grid.Row="6" Text="Integrations" /><TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Exchanges}" TextWrapping="Wrap" />
      </Grid>
      <TextBlock Text="Workspace display name" FontSize="16" FontWeight="SemiBold" Margin="0,28,0,8" />
      <TextBox Text="{Binding WorkspaceName, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" MaxLength="100" Padding="8" AutomationProperties.Name="Workspace display name" />
      <Button Content="Save workspace name" Command="{Binding SaveCommand}" IsEnabled="{Binding CanEdit}" HorizontalAlignment="Left" Padding="16,8" Margin="0,10,0,0" />
    </StackPanel>
  </ScrollViewer>
</Window>
