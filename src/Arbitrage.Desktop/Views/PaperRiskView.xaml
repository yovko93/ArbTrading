<UserControl x:Class="Arbitrage.Desktop.Views.PaperRiskView" Language="en-US"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Border Style="{StaticResource CardBorder}"><StackPanel>
  <TextBlock Text="Paper capital and risk policy" Style="{StaticResource MetricText}"/>
  <TextBlock Text="Applies only to NEW paper entries. Does not close positions, settle markets, change balances, or alter real exchange accounts. Suggested values are inactive until saved. Enter decimals with a dot; percentages use 20 for 20%." TextWrapping="Wrap" Margin="0,8"/>
  <TextBlock Text="{Binding RiskStatusText}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
  <TextBlock Text="{Binding RiskNotice}" TextWrapping="Wrap" Margin="0,8"/>
  <ItemsControl ItemsSource="{Binding RiskInputs}">
   <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
   <ItemsControl.ItemTemplate><DataTemplate><StackPanel Width="225" Margin="0,6,12,6">
    <TextBlock Text="{Binding Name}"/><TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Name}"/>
   </StackPanel></DataTemplate></ItemsControl.ItemTemplate>
  </ItemsControl>
  <WrapPanel><Button Content="Refresh risk status" Command="{Binding RefreshRiskCommand}"/>
   <Button Content="Load saved policy into form" Command="{Binding LoadRiskPolicyCommand}" Margin="8,0"/>
   <Button Content="Save Risk Policy…" Command="{Binding SaveRiskPolicyCommand}"/></WrapPanel>
 </StackPanel></Border>
</UserControl>
