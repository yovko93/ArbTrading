<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:controls="clr-namespace:Arbitrage.Desktop.Controls" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Arbitrage.Desktop.Views.MarketExplorerView" Background="{DynamicResource ApplicationBackground}">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Arbitrage.Desktop;component/Resources/Styles/MarketWorkflow.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="WorkflowScroll">
    <StackPanel>
      <controls:SectionHeader Title="Market Explorer" Subtitle="Local catalog of public prediction market metadata" />
      <TextBlock Text="{Binding ScopeNotice}" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,8,0,10" />
      <ItemsControl ItemsSource="{Binding ExchangeStatuses}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource WorkflowCard}" Margin="0,0,0,10">
              <StackPanel>
                <WrapPanel>
                  <TextBlock Text="{Binding Exchange}" Style="{StaticResource SectionTitleText}" Margin="0,0,10,0" />
                  <controls:StatusBadge Style="{StaticResource WorkflowState}" Label="{Binding LatestRun.State, TargetNullValue=Never, FallbackValue=Never}" Margin="0,0,8,6" />
                </WrapPanel>
                <WrapPanel>
                  <Border Style="{StaticResource WorkflowMetric}">
                    <StackPanel>
                      <TextBlock Text="STORED MARKETS" Style="{StaticResource EyebrowText}" />
                      <TextBlock Text="{Binding StoredMarkets, TargetNullValue=Unavailable, FallbackValue=Unavailable}" Style="{StaticResource MetricText}" />
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource WorkflowMetric}">
                    <StackPanel>
                      <TextBlock Text="OBSERVED" Style="{StaticResource EyebrowText}" />
                      <TextBlock Text="{Binding LatestRun.MarketsObserved, TargetNullValue=0, FallbackValue=0}" Style="{StaticResource MetricText}" />
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource WorkflowMetric}">
                    <StackPanel>
                      <TextBlock Text="PAGES" Style="{StaticResource EyebrowText}" />
                      <TextBlock Text="{Binding LatestRun.Pages, TargetNullValue=0, FallbackValue=0}" Style="{StaticResource MetricText}" />
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource WorkflowMetric}">
                    <StackPanel>
                      <TextBlock Text="MALFORMED" Style="{StaticResource EyebrowText}" />
                      <TextBlock Text="{Binding LatestRun.MalformedRecords, TargetNullValue=0, FallbackValue=0}" Style="{StaticResource MetricText}" />
                    </StackPanel>
                  </Border>
                  <StackPanel Margin="4,0,0,8" MaxWidth="390">
                    <TextBlock Text="{Binding LatestRun.ErrorCode, StringFormat=Reason: {0}, TargetNullValue=Reason: None}" />
                    <TextBlock Text="{Binding LatestRetrievedAt, StringFormat=Cache updated: {0:yyyy-MM-dd HH:mm} UTC, TargetNullValue=Cache updated: Never}" Style="{StaticResource MutedText}" Margin="0,0,18,0" />
                    <TextBlock Text="{Binding LastCompletedAt, StringFormat=Last complete: {0:yyyy-MM-dd HH:mm} UTC, TargetNullValue=Last complete: Never}" Style="{StaticResource MutedText}" />
                  </StackPanel>
                </WrapPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Border Style="{StaticResource WorkflowCard}">
        <StackPanel>
          <TextBlock Text="Filter catalog" Style="{StaticResource SectionTitleText}" Margin="0,0,0,10" />
          <WrapPanel>
            <StackPanel Style="{StaticResource WorkflowField}">
              <TextBlock Text="Exchange" Style="{StaticResource FieldLabel}" />
              <ComboBox ItemsSource="{Binding Exchanges}" SelectedItem="{Binding SelectedExchange}" Width="105" />
            </StackPanel>
            <StackPanel Style="{StaticResource WorkflowField}">
              <TextBlock Text="Search stored markets" Style="{StaticResource FieldLabel}" />
              <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Width="180" AutomationProperties.Name="Search stored market titles and identifiers" />
            </StackPanel>
            <StackPanel Style="{StaticResource WorkflowField}">
              <TextBlock Text="Status" Style="{StaticResource FieldLabel}" />
              <ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding SelectedStatus}" Width="125" />
            </StackPanel>
            <StackPanel Style="{StaticResource WorkflowField}">
              <TextBlock Text="Category / tag" Style="{StaticResource FieldLabel}" />
              <ComboBox ItemsSource="{Binding Tags}" SelectedItem="{Binding SelectedTag}" Width="120" AutomationProperties.Name="Category or tag filter" />
            </StackPanel>
            <StackPanel Style="{StaticResource WorkflowField}">
              <TextBlock Text="Sort" Style="{StaticResource FieldLabel}" />
              <ComboBox ItemsSource="{Binding Sorts}" SelectedItem="{Binding SelectedSort}" Width="85" AutomationProperties.Name="Catalog sort" />
            </StackPanel>
            <Button Content="Apply" Command="{Binding ApplyFiltersCommand}" Margin="0,0,8,6" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" />
            <Button Content="Sync Markets" Command="{Binding SyncCommand}" Margin="0,0,8,6" Style="{StaticResource SuccessButton}" VerticalAlignment="Bottom" />
            <Button Content="Cancel Sync" Command="{Binding CancelCommand}" IsEnabled="{Binding CanCancel}" Style="{StaticResource DangerButton}" Margin="0,0,8,6" VerticalAlignment="Bottom" />
          </WrapPanel>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource WorkflowNotice}" ToolTip="{Binding Notice}">
        <TextBlock Text="{Binding Notice}" />
      </Border>
      <Border Style="{StaticResource WorkflowCard}">
        <StackPanel>
          <TextBlock Text="Stored markets" Style="{StaticResource SectionTitleText}" Margin="0,0,0,10" />
          <ListView ItemsSource="{Binding Markets}" SelectedItem="{Binding SelectedMarket, Mode=TwoWay}" Background="{DynamicResource SurfaceBackground}" Foreground="{DynamicResource PrimaryText}" AutomationProperties.Name="Locally stored public markets" MaxHeight="250" MinHeight="100">
            <ListView.View>
              <GridView>
                <GridViewColumn Header="Exchange" DisplayMemberBinding="{Binding Exchange}" Width="100" />
                <GridViewColumn Header="Title / question" DisplayMemberBinding="{Binding Title}" Width="320" />
                <GridViewColumn Header="Native ID" DisplayMemberBinding="{Binding NativeId}" Width="170" />
                <GridViewColumn Header="Status" DisplayMemberBinding="{Binding Status}" Width="110" />
                <GridViewColumn Header="Tag" DisplayMemberBinding="{Binding Tags[0]}" Width="105" />
                <GridViewColumn Header="Closes (UTC)" DisplayMemberBinding="{Binding CloseAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="130" />
                <GridViewColumn Header="Retrieved (UTC)" DisplayMemberBinding="{Binding RetrievedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="130" />
              </GridView>
            </ListView.View>
          </ListView>
          <DockPanel Margin="0,8,0,8">
            <Button DockPanel.Dock="Right" Content="Next" Command="{Binding NextCommand}" IsEnabled="{Binding CanNext}" Margin="0,0,8,6" Style="{StaticResource SecondaryButton}" VerticalAlignment="Bottom" />
            <Button DockPanel.Dock="Right" Content="Previous" Command="{Binding PreviousCommand}" IsEnabled="{Binding CanPrevious}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,6" VerticalAlignment="Bottom" />
            <TextBlock Text="{Binding PageLabel}" VerticalAlignment="Center" />
          </DockPanel>
        </StackPanel>
      </Border>
      <Border AutomationProperties.AutomationId="MarketEmptyState">
        <Border.Style>
          <Style TargetType="Border" BasedOn="{StaticResource WorkflowCard}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Binding="{Binding SelectedMarket}" Value="{x:Null}" />
                  <Condition Binding="{Binding OrderBook.Response}" Value="{x:Null}" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Visibility" Value="Visible" />
              </MultiDataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <StackPanel>
          <TextBlock Text="Market inspector" Style="{StaticResource SectionTitleText}" Margin="0,0,0,10" />
          <TextBlock Text="Select a market to inspect cached metadata and orderbook state." Style="{StaticResource MutedText}" />
        </StackPanel>
      </Border>
      <Border AutomationProperties.AutomationId="MarketInspector">
        <Border.Style>
          <Style TargetType="Border" BasedOn="{StaticResource WorkflowCard}">
            <Style.Triggers>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Binding="{Binding SelectedMarket}" Value="{x:Null}" />
                  <Condition Binding="{Binding OrderBook.Response}" Value="{x:Null}" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Visibility" Value="Collapsed" />
              </MultiDataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <StackPanel>
          <TextBlock Text="Market inspector" Style="{StaticResource SectionTitleText}" Margin="0,0,0,10" />
          <TextBlock Text="{Binding Detail.Title, TargetNullValue=Cached metadata and orderbook state}" Style="{StaticResource SectionTitleText}" />
          <StackPanel DataContext="{Binding OrderBook}" Margin="0,0,0,16">
            <TextBlock Text="Order Book · read-only market data" FontWeight="SemiBold" FontSize="16" Style="{StaticResource SectionTitleText}" />
            <WrapPanel>
              <controls:StatusBadge Style="{StaticResource WorkflowState}" Label="{Binding Response.Realtime.Continuity, TargetNullValue=Unavailable, FallbackValue=Unavailable}" Margin="0,0,8,6" />
              <controls:StatusBadge Style="{StaticResource WorkflowState}" Label="{Binding Response.State, TargetNullValue=Unavailable, FallbackValue=Unavailable}" Margin="0,0,8,6" />
            </WrapPanel>
            <WrapPanel Margin="0,8,0,8">
              <ComboBox ItemsSource="{Binding Instruments}" SelectedItem="{Binding SelectedInstrument}" MinWidth="150" AutomationProperties.Name="Orderbook outcome" Width="160" Margin="0,0,8,6">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Outcome}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <Button Content="Refresh Order Book" Command="{Binding RefreshCommand}" Margin="0,0,8,6" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" />
              <Button Content="Start Realtime" Command="{Binding StartRealtimeCommand}" Margin="0,0,8,6" Style="{StaticResource SuccessButton}" VerticalAlignment="Bottom" />
              <Button Content="Stop Realtime" Command="{Binding StopRealtimeCommand}" Margin="0,0,8,6" Style="{StaticResource DangerButton}" VerticalAlignment="Bottom" />
              <TextBlock Text="{Binding SnapshotState}" VerticalAlignment="Center" Margin="12,0,0,0" />
            </WrapPanel>
            <WrapPanel>
              <TextBlock Text="{Binding SelectedInstrument.Exchange}" Margin="0,0,12,0" />
              <TextBlock Text="{Binding SelectedInstrument.NativeMarketId}" TextWrapping="Wrap" Margin="0,0,12,0" />
              <TextBlock Text="{Binding SelectedInstrument.NativeInstrumentId, StringFormat=Instrument: {0}}" TextWrapping="Wrap" MaxWidth="540" />
            </WrapPanel>
            <TextBlock Text="{Binding RealtimeDetails}" TextWrapping="Wrap" Margin="0,0,0,6" />
            <WrapPanel>
              <TextBlock Text="{Binding Response.Snapshot.RetrievedAtUtc, StringFormat=Retrieved: {0:yyyy-MM-dd HH:mm:ss} UTC, TargetNullValue=Retrieved: unavailable}" Margin="0,0,12,0" />
              <TextBlock Text="{Binding Response.Snapshot.SourceTimestamp, StringFormat=Source: {0:yyyy-MM-dd HH:mm:ss} UTC, TargetNullValue=Source: unavailable}" Margin="0,0,12,0" />
              <TextBlock Text="{Binding Age}" Margin="0,0,0,0" />
            </WrapPanel>
            <TextBlock Text="{Binding Provenance}" Foreground="{DynamicResource SecondaryText}" />
            <WrapPanel>
              <Border Style="{StaticResource WorkflowMetric}">
                <StackPanel>
                  <TextBlock Text="BEST BID" Style="{StaticResource EyebrowText}" />
                  <TextBlock Text="{Binding BestBid, TargetNullValue=Unavailable, FallbackValue=Unavailable}" Style="{StaticResource MetricText}" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource WorkflowMetric}">
                <StackPanel>
                  <TextBlock Text="BEST ASK" Style="{StaticResource EyebrowText}" />
                  <TextBlock Text="{Binding BestAsk, TargetNullValue=Unavailable, FallbackValue=Unavailable}" Style="{StaticResource MetricText}" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource WorkflowMetric}">
                <StackPanel>
                  <TextBlock Text="SPREAD" Style="{StaticResource EyebrowText}" />
                  <TextBlock Text="{Binding Spread, TargetNullValue=Unavailable, FallbackValue=Unavailable}" Style="{StaticResource MetricText}" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource WorkflowMetric}">
                <StackPanel>
                  <TextBlock Text="AGE / FRESHNESS" Style="{StaticResource EyebrowText}" />
                  <TextBlock Text="{Binding Age, TargetNullValue=Unavailable, FallbackValue=Unavailable}" Style="{StaticResource MetricText}" />
                </StackPanel>
              </Border>
            </WrapPanel>
            <Border Style="{StaticResource WorkflowNotice}" ToolTip="{Binding Notice}">
              <TextBlock Text="{Binding Notice}" />
            </Border>
            <Border Margin="0,0,0,10">
              <Border.Style><Style TargetType="Border" BasedOn="{StaticResource StatusBanner}">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers><DataTrigger Binding="{Binding Response.Snapshot}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
              </Style></Border.Style>
              <TextBlock Text="No orderbook snapshot available. Refresh Order Book explicitly to request public market data."/>
            </Border>
            <Grid>
              <Grid.Style>
                <Style TargetType="Grid">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Response.Snapshot}" Value="{x:Null}">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Grid.Style>
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,8,0">
                <TextBlock Text="Bids · best 10 levels" FontWeight="SemiBold" />
                <ListView ItemsSource="{Binding Bids}" MaxHeight="220" Background="{DynamicResource SurfaceBackground}" Foreground="{DynamicResource PrimaryText}">
                  <ListView.View>
                    <GridView>
                      <GridViewColumn Header="Price" DisplayMemberBinding="{Binding Price, StringFormat={}{0:G29}}" Width="90" />
                      <GridViewColumn Header="Quantity" DisplayMemberBinding="{Binding Quantity, StringFormat={}{0:G29}}" Width="110" />
                      <GridViewColumn Header="Origin" DisplayMemberBinding="{Binding Origin}" Width="140" />
                    </GridView>
                  </ListView.View>
                </ListView>
              </StackPanel>
              <StackPanel Grid.Column="1">
                <TextBlock Text="Asks · best 10 levels" FontWeight="SemiBold" />
                <ListView ItemsSource="{Binding Asks}" MaxHeight="220" Background="{DynamicResource SurfaceBackground}" Foreground="{DynamicResource PrimaryText}">
                  <ListView.View>
                    <GridView>
                      <GridViewColumn Header="Price" DisplayMemberBinding="{Binding Price, StringFormat={}{0:G29}}" Width="90" />
                      <GridViewColumn Header="Quantity" DisplayMemberBinding="{Binding Quantity, StringFormat={}{0:G29}}" Width="110" />
                      <GridViewColumn Header="Origin" DisplayMemberBinding="{Binding Origin}" Width="140" />
                    </GridView>
                  </ListView.View>
                </ListView>
              </StackPanel>
            </Grid>
            <WrapPanel Margin="0,8,0,4">
              <ComboBox ItemsSource="{Binding DepthSides}" SelectedItem="{Binding DepthSide}" Width="130" AutomationProperties.Name="Depth side">
                </ComboBox>
              <TextBox Text="{Binding DepthQuantity, UpdateSourceTrigger=PropertyChanged}" Width="100" Margin="8,0" AutomationProperties.Name="Diagnostic depth quantity" />
              <Button Content="Preview gross depth" Command="{Binding PreviewDepthCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,6" VerticalAlignment="Bottom" />
            </WrapPanel>
            <TextBlock Text="{Binding DepthNotice}" TextWrapping="Wrap" />
            <TextBlock Text="Gross orderbook data — fees and strategy logic not included." Foreground="{DynamicResource SecondaryText}" Margin="0,6,0,0" />
          </StackPanel>
          <Border Style="{StaticResource InsetPanel}">
            <StackPanel>
              <TextBlock Text="Cached market metadata" Style="{StaticResource SectionTitleText}" Margin="0,0,0,10" />
              <TextBlock Text="Selected market · cached metadata" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Detail.Title, TargetNullValue=Select a market above}" FontSize="16" TextWrapping="Wrap" Margin="0,5,0,3" />
              <TextBlock Text="{Binding Detail.NativeId}" />
              <TextBlock Text="{Binding Detail.EventId, StringFormat=Event: {0}}" />
              <TextBlock Text="{Binding Detail.GroupId, StringFormat=Group: {0}}" />
              <TextBlock Text="{Binding Detail.Classification}" />
              <TextBlock Text="{Binding Detail.NativeStatus}" />
              <TextBlock Text="{Binding Detail.CloseAt, StringFormat=Closes: {0:yyyy-MM-dd HH:mm} UTC}" />
              <TextBlock Text="{Binding Detail.RetrievedAt, StringFormat=Retrieved: {0:yyyy-MM-dd HH:mm} UTC}" />
              <ItemsControl ItemsSource="{Binding Detail.Tags}" />
              <ItemsControl ItemsSource="{Binding Detail.Outcomes}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding Label}" />
                      <TextBlock Text="  ·  " />
                      <TextBlock Text="{Binding NativeTokenId}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ItemsControl ItemsSource="{Binding Detail.Warnings}" />
              <TextBlock Text="{Binding Detail.Description}" TextWrapping="Wrap" Margin="0,5,0,0" />
              <TextBlock Text="{Binding Detail.Rules}" TextWrapping="Wrap" Margin="0,5,0,0" />
              <TextBlock Text="Rules text is source supplied and unverified." Foreground="{DynamicResource SecondaryText}" Margin="0,5,0,0" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
