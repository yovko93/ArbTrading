<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Single vector source for the in-app mark and the generated Windows icon. -->
    <DrawingImage x:Key="AppMark">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#121E2C">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,256,256" RadiusX="52" RadiusY="52" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#59B9F5" Geometry="M 50,62 L 150,62 L 150,40 L 210,80 L 150,120 L 150,98 L 50,98 Z" />
                <GeometryDrawing Brush="#51D2A1" Geometry="M 206,158 L 106,158 L 106,136 L 46,176 L 106,216 L 106,194 L 206,194 Z" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
</ResourceDictionary>
