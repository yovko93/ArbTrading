      }
    },
    {
      "Type": "Column",
      "Attributes": {
        "Header": "Local time",
        "ValueBinding": "{Binding LocalTimestamp, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
      }
    },
    {
      "Type": "Column",
      "Attributes": {
        "Header": "Severity",
        "ValueBinding": "{Binding Severity}"
      }
    },
    {
      "Type": "Column",
      "Attributes": {
        "Header": "Event",
        "ValueBinding": "{Binding Description}"
      }
    }
  ],
  "SettingsView": [
    {
