<UserControl x:Class="Arbitrage.Desktop.Controls.StatusBadge"
             x:Name="Root" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border x:Name="BadgeBorder" Background="{DynamicResource ElevatedSurfaceBackground}"
          BorderBrush="{DynamicResource DefaultBorder}" BorderThickness="1" CornerRadius="4" Padding="7,3">
    <TextBlock x:Name="BadgeText" Text="{Binding Label, ElementName=Root}" FontSize="11" FontWeight="SemiBold"
               Foreground="{DynamicResource PrimaryText}" />
  </Border>
</UserControl>
