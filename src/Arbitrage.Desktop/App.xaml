<Application x:Class="Arbitrage.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Resources/Themes/Colors.Light.xaml" />
        <ResourceDictionary Source="Resources/Themes/Brushes.xaml" />
        <ResourceDictionary Source="Resources/Styles/Typography.xaml" />
        <ResourceDictionary Source="Resources/Styles/Layout.xaml" />
        <ResourceDictionary Source="Resources/Styles/Controls.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
