<UserControl x:Class="Arbitrage.Desktop.Views.PaperAutomationView" Language="en-US"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources>
  <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="3"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/></Border></ControlTemplate></Setter.Value></Setter>
   <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></Style.Triggers>
  </Style>
 </UserControl.Resources>
 <Border Style="{StaticResource CardBorder}"><StackPanel>
  <TextBlock Text="Automatic Paper Execution · SIMULATION ONLY" Style="{StaticResource MetricText}"/>
  <TextBlock Text="Mode remains Paper. No real orders. Explicitly arm each backend session. Closing this app or losing its connection does not disarm the backend. Disarm stops new entries; Emergency stop persists a kill switch until explicitly reset." TextWrapping="Wrap" Margin="0,8"/>
  <TextBlock Text="{Binding AutomationStatusText}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
  <WrapPanel Margin="0,10"><Button Content="Refresh Auto Paper" Command="{Binding RefreshAutomationCommand}"/>
   <Button Content="Arm Auto Paper…" Command="{Binding ArmAutomationCommand}" Margin="8,0"/>
   <Button Content="Disarm" Command="{Binding DisarmAutomationCommand}"/>
   <Button Content="EMERGENCY STOP" Command="{Binding EmergencyStopAutomationCommand}" FontWeight="Bold" BorderThickness="2" Margin="8,0"/>
   <Button Content="Reset kill switch…" Command="{Binding ResetAutomationKillCommand}"/></WrapPanel>
  <TextBlock Text="{Binding AutomationNotice}" TextWrapping="Wrap" Margin="0,8"/>
  <TextBlock Text="FixedQuantity only · Realtime required · Kalshi Continuous. Suggested values are inactive until saved. USD and USDC budgets remain separate. No automatic exits or settlement." TextWrapping="Wrap"/>
  <ItemsControl ItemsSource="{Binding AutomationInputs}">
   <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
   <ItemsControl.ItemTemplate><DataTemplate><StackPanel Width="250" Margin="0,6,12,6">
    <TextBlock Text="{Binding Name}" TextWrapping="Wrap"/><TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Name}"/>
   </StackPanel></DataTemplate></ItemsControl.ItemTemplate>
  </ItemsControl>
  <CheckBox Content="Allow Polymarket BestEffort (weaker continuity; acknowledged on save and arm)" IsChecked="{Binding AllowPolymarketBestEffort}" Margin="0,8"/>
  <WrapPanel><Button Content="Load saved Auto Paper settings" Command="{Binding LoadAutomationProfileCommand}"/>
   <Button Content="Save Auto Paper profile…" Command="{Binding SaveAutomationCommand}" Margin="8,0"/></WrapPanel>
 </StackPanel></Border>
</UserControl>
