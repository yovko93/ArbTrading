<UserControl x:Class="Arbitrage.Desktop.Views.StrategiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Arbitrage.Desktop.Controls">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel MaxWidth="1100" HorizontalAlignment="Left">
      <controls:SectionHeader Title="Strategies" Subtitle="Read-only guide to the local arbitrage evaluation workflow." />
      <Border Style="{StaticResource CardBorder}">
        <StackPanel>
          <TextBlock Text="Current capability" Style="{StaticResource SectionTitleText}" />
          <TextBlock Text="The engine evaluates verified market relationships against observed orderbook depth and configured fee profiles. Results and rejection reasons appear in Opportunities." TextWrapping="Wrap" Margin="0,8,0,0" />
          <TextBlock Text="Strategy engine: Implemented · deterministic arbitrage opportunity evaluation" TextWrapping="Wrap" Margin="0,8,0,0" />
          <TextBlock Text="Execution environment: Paper only · live orders unavailable" TextWrapping="Wrap" Margin="0,4,0,0" />
          <TextBlock Text="Paper eligibility requires deterministic relationship verification and fee-aware execution checks." TextWrapping="Wrap" Margin="0,4,0,0" />
          <TextBlock Text="Trading environment" Style="{StaticResource FieldLabel}" Margin="0,14,0,4" />
          <TextBlock Text="{Binding State.TradingMode}" />
          <TextBlock Text="Paper execution" Style="{StaticResource FieldLabel}" Margin="0,10,0,4" />
          <TextBlock Text="{Binding State.PaperExecutionLabel}" />
          <TextBlock Text="Live order submission" Style="{StaticResource FieldLabel}" Margin="0,10,0,4" />
          <TextBlock Text="{Binding State.LiveExecutionLabel}" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource CardBorder}">
        <StackPanel>
          <TextBlock Text="How to inspect a strategy result" Style="{StaticResource SectionTitleText}" />
          <TextBlock Text="1. Review public markets in Market Explorer and verify their relationship in Market Matching." TextWrapping="Wrap" Margin="0,9,0,4" />
          <TextBlock Text="2. Review fee-aware candidate economics and blockers in Opportunities." TextWrapping="Wrap" Margin="0,0,0,4" />
          <TextBlock Text="3. Use Trading for explicitly confirmed paper execution. Portfolio shows balances, positions, and performance." TextWrapping="Wrap" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource CardBorder}">
        <StackPanel>
          <TextBlock Text="Configuration boundary" Style="{StaticResource SectionTitleText}" />
          <TextBlock Text="This page has no independent strategy catalog, enable/disable controls, or per-strategy settings. Strategy behavior is governed by the existing relationship, opportunity, fee, and paper risk workflows." TextWrapping="Wrap" Margin="0,8,0,0" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
