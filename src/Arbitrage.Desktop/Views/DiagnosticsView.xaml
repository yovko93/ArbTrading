<UserControl x:Class="Arbitrage.Desktop.Views.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Arbitrage.Desktop.Controls"
             Loaded="OnLoaded" Unloaded="OnUnloaded">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Resources/Styles/MarketWorkflow.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <DataTemplate x:Key="DiagnosticSeverity">
        <controls:StatusBadge Label="{Binding Severity}" Style="{StaticResource WorkflowState}" />
      </DataTemplate>
    </ResourceDictionary>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
      <controls:SectionHeader Title="Logs &amp; Diagnostics" Subtitle="Authorized backend events and desktop-local events. This bounded recent feed is not an audit ledger." />
      <Border Style="{StaticResource WorkflowCard}" AutomationProperties.AutomationId="DiagnosticsConnection">
        <StackPanel>
          <TextBlock Text="CONNECTION &amp; SYNCHRONIZATION" Style="{StaticResource EyebrowText}" />
          <TextBlock Text="Backend connection and synchronization" Style="{StaticResource SectionTitleText}" Margin="0,3,0,10" />
          <WrapPanel>
            <Border Style="{StaticResource WorkflowMetric}" Width="250"><StackPanel>
              <TextBlock Text="CONNECTION" Style="{StaticResource EyebrowText}" />
              <TextBlock Text="{Binding State.ConnectionStatus}" FontWeight="SemiBold" Margin="0,5,0,0" />
            </StackPanel></Border>
            <Border Style="{StaticResource WorkflowMetric}" Width="250"><StackPanel>
              <TextBlock Text="TRANSPORT" Style="{StaticResource EyebrowText}" />
              <TextBlock Text="{Binding State.TransportStatus}" Margin="0,5,0,0" />
            </StackPanel></Border>
            <Border Style="{StaticResource WorkflowMetric}" Width="250"><StackPanel>
              <TextBlock Text="HEARTBEAT" Style="{StaticResource EyebrowText}" />
              <TextBlock Text="{Binding State.HeartbeatStatus}" Margin="0,5,0,0" />
            </StackPanel></Border>
          </WrapPanel>
          <TextBlock Text="{Binding State.DataAge}" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
          <TextBlock Text="{Binding State.LastRefreshLabel}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource WorkflowCard}" AutomationProperties.AutomationId="DiagnosticsBackendStream">
        <StackPanel>
          <TextBlock Text="AUTHORIZED BACKEND" Style="{StaticResource EyebrowText}" />
          <TextBlock Text="Backend events" Style="{StaticResource SectionTitleText}" Margin="0,3,0,8" />
          <Border Style="{StaticResource WorkflowNotice}" ToolTip="{Binding Text, ElementName=BackendNoticeText}">
            <TextBlock x:Name="BackendNoticeText" TextWrapping="Wrap" />
          </Border>
          <WrapPanel Margin="0,0,0,2">
            <StackPanel Style="{StaticResource WorkflowField}">
              <TextBlock Text="Severity" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
              <ComboBox x:Name="SeverityFilter" Width="160" SelectedIndex="0" SelectionChanged="OnFilterChanged" AutomationProperties.Name="Backend severity filter">
                <ComboBoxItem Content="All" /><ComboBoxItem Content="Information" /><ComboBoxItem Content="Warning" /><ComboBoxItem Content="Error" />
              </ComboBox>
            </StackPanel>
            <StackPanel Style="{StaticResource WorkflowField}">
              <TextBlock Text="Source" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
              <ComboBox x:Name="SourceFilter" Width="160" SelectedIndex="0" SelectionChanged="OnFilterChanged" AutomationProperties.Name="Backend source filter">
                <ComboBoxItem Content="All" /><ComboBoxItem Content="Backend" /><ComboBoxItem Content="Workspace" /><ComboBoxItem Content="Realtime" /><ComboBoxItem Content="Runtime" />
              </ComboBox>
            </StackPanel>
          </WrapPanel>
          <ListView x:Name="BackendList" ItemsSource="{Binding Diagnostics.BackendEvents}" BorderThickness="0" MaxHeight="320"
                    AutomationProperties.Name="Authorized backend diagnostic events">
            <ListView.Style>
              <Style TargetType="ListView" BasedOn="{StaticResource {x:Type ListView}}">
                <Setter Property="MinHeight" Value="110" />
                <Style.Triggers><Trigger Property="HasItems" Value="False"><Setter Property="Visibility" Value="Collapsed" /></Trigger></Style.Triggers>
              </Style>
            </ListView.Style>
            <ListView.View><GridView>
              <GridViewColumn Header="UTC time" Width="172" DisplayMemberBinding="{Binding OccurredAtUtc, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" />
              <GridViewColumn Header="Severity" Width="118" CellTemplate="{StaticResource DiagnosticSeverity}" />
              <GridViewColumn Header="Source" Width="100" DisplayMemberBinding="{Binding Source}" />
              <GridViewColumn Header="Event" Width="450" DisplayMemberBinding="{Binding Message}" />
            </GridView></ListView.View>
          </ListView>
          <Border AutomationProperties.AutomationId="DiagnosticsBackendEmpty">
            <Border.Style>
              <Style TargetType="Border" BasedOn="{StaticResource InsetPanel}">
                <Setter Property="Padding" Value="14" /><Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=BackendList}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
              </Style>
            </Border.Style>
            <StackPanel>
              <TextBlock Text="No backend events in this view" FontWeight="SemiBold" Margin="0,0,0,4" />
              <TextBlock Text="The synchronization notice above describes backend history availability. Severity and source filters apply to retained events." Style="{StaticResource MutedText}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource WorkflowCard}" AutomationProperties.AutomationId="DiagnosticsDesktopStream">
        <StackPanel>
          <TextBlock Text="THIS DESKTOP SESSION" Style="{StaticResource EyebrowText}" />
          <TextBlock Text="Desktop-local events" Style="{StaticResource SectionTitleText}" Margin="0,3,0,4" />
          <TextBlock Text="Current desktop run only · newest first · maximum 200 events" Style="{StaticResource MutedText}" Margin="0,0,0,10" />
          <ListView x:Name="DesktopList" ItemsSource="{Binding Diagnostics.Events}" BorderThickness="0" MaxHeight="250" AutomationProperties.Name="Desktop diagnostic events">
            <ListView.Style>
              <Style TargetType="ListView" BasedOn="{StaticResource {x:Type ListView}}">
                <Setter Property="MinHeight" Value="100" />
                <Style.Triggers><Trigger Property="HasItems" Value="False"><Setter Property="Visibility" Value="Collapsed" /></Trigger></Style.Triggers>
              </Style>
            </ListView.Style>
            <ListView.View><GridView>
              <GridViewColumn Header="Local time" Width="175" DisplayMemberBinding="{Binding LocalTimestamp, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" />
              <GridViewColumn Header="Severity" Width="118" CellTemplate="{StaticResource DiagnosticSeverity}" />
              <GridViewColumn Header="Event" Width="540" DisplayMemberBinding="{Binding Description}" />
            </GridView></ListView.View>
          </ListView>
          <Border AutomationProperties.AutomationId="DiagnosticsDesktopEmpty">
            <Border.Style>
              <Style TargetType="Border" BasedOn="{StaticResource InsetPanel}">
                <Setter Property="Padding" Value="14" /><Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=DesktopList}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
              </Style>
            </Border.Style>
            <StackPanel>
              <TextBlock Text="No desktop events recorded" FontWeight="SemiBold" Margin="0,0,0,4" />
              <TextBlock Text="Events from this desktop run will appear here. Backend events remain in the separate stream above." Style="{StaticResource MutedText}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
