<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:controls="clr-namespace:Arbitrage.Desktop.Controls" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Arbitrage.Desktop.Views.RelationshipsView" Background="{DynamicResource ApplicationBackground}">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Arbitrage.Desktop;component/Resources/Styles/MarketWorkflow.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="WorkflowScroll">
    <StackPanel>
      <TextBlock Text="Market Matching" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" Style="{StaticResource PageTitleText}" Margin="0,0,0,6" />
      <TextBlock Text="Inspect reasons not to match. Titles, labels and group membership never establish settlement equivalence." TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,0,0,12" />
      <Border Style="{StaticResource WorkflowCard}">
        <StackPanel>
          <TextBlock Text="Candidate generation" Style="{StaticResource SectionTitleText}" Margin="0,0,0,10" />
          <WrapPanel Margin="0,8">
            <StackPanel Style="{StaticResource WorkflowField}">
              <TextBlock Style="{StaticResource FieldLabel}" Text="Exchange" />
              <ComboBox ItemsSource="{Binding Exchanges}" SelectedItem="{Binding Exchange}" Width="120" AutomationProperties.Name="Exchange filter" />
            </StackPanel>
            <StackPanel Style="{StaticResource WorkflowField}">
              <TextBlock Style="{StaticResource FieldLabel}" Text="Verification state" />
              <ComboBox ItemsSource="{Binding States}" SelectedItem="{Binding Status}" Width="165" AutomationProperties.Name="Verification filter" />
            </StackPanel>
            <StackPanel Style="{StaticResource WorkflowField}">
              <TextBlock Style="{StaticResource FieldLabel}" Text="Relationship type" />
              <ComboBox ItemsSource="{Binding Types}" SelectedItem="{Binding Type}" Width="205" AutomationProperties.Name="Relationship type filter" />
            </StackPanel>
            <Button Content="Apply filters" Command="{Binding ApplyFiltersCommand}" Margin="0,0,8,6" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" />
            <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,6" VerticalAlignment="Bottom" />
          </WrapPanel>
          <WrapPanel>
            <StackPanel Style="{StaticResource WorkflowField}">
              <TextBlock Style="{StaticResource FieldLabel}" Text="Native market ID (optional)" />
              <TextBox Text="{Binding SelectedNativeId, UpdateSourceTrigger=PropertyChanged}" Width="180" ToolTip="Optional native market ID; choose its exchange above" AutomationProperties.Name="Optional selected native market ID" />
            </StackPanel>
            <CheckBox Content="Cross exchange" IsChecked="{Binding CrossExchange}" VerticalAlignment="Center" Margin="8,0" />
            <Button Content="Generate Candidates" Command="{Binding GenerateCommand}" Style="{StaticResource SuccessButton}" Margin="0,0,8,6" VerticalAlignment="Bottom" />
            <Button Content="Cancel job" Command="{Binding CancelJobCommand}" Margin="0,0,8,6" Style="{StaticResource DangerButton}" VerticalAlignment="Bottom" />
            <controls:StatusBadge Style="{StaticResource WorkflowState}" Label="{Binding Job.State, TargetNullValue=Never, FallbackValue=Never}" Margin="0,0,8,6" />
          </WrapPanel>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource WorkflowNotice}" ToolTip="{Binding Notice}">
        <TextBlock Text="{Binding Notice}" />
      </Border>
      <Border Style="{StaticResource WorkflowNotice}" ToolTip="{Binding Job.Notice}">
        <TextBlock Text="{Binding Job.Notice}" />
      </Border>
      <Border Style="{StaticResource WorkflowCard}">
        <StackPanel>
          <TextBlock Text="Candidate relationships" Style="{StaticResource SectionTitleText}" Margin="0,0,0,10" />
          <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" AutomationProperties.Name="Candidate relationships" MaxHeight="240" MinHeight="100">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Exchange A" Binding="{Binding SourceExchange}" Width="90" ElementStyle="{StaticResource WorkflowCellText}" />
              <DataGridTextColumn Header="Market A" Binding="{Binding SourceTitle}" Width="*" MinWidth="180" ElementStyle="{StaticResource WorkflowCellText}" />
              <DataGridTextColumn Header="Exchange B" Binding="{Binding TargetExchange}" Width="90" ElementStyle="{StaticResource WorkflowCellText}" />
              <DataGridTextColumn Header="Market B" Binding="{Binding TargetTitle}" Width="*" MinWidth="180" ElementStyle="{StaticResource WorkflowCellText}" />
              <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="135" ElementStyle="{StaticResource WorkflowCellText}" />
              <DataGridTextColumn Header="Trust / stale" Binding="{Binding State}" Width="130" ElementStyle="{StaticResource WorkflowCellText}" />
              <DataGridTextColumn Header="Validated UTC" Binding="{Binding LastValidatedAt}" Width="145" ElementStyle="{StaticResource WorkflowCellText}" />
            </DataGrid.Columns>
          </DataGrid>
          <WrapPanel Margin="0,6">
            <Button Content="Previous" Command="{Binding PreviousCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,6" VerticalAlignment="Bottom" />
            <TextBlock Text="{Binding PageLabel}" Margin="12,0" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryText}" />
            <Button Content="Next" Command="{Binding NextCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,6" VerticalAlignment="Bottom" />
          </WrapPanel>
        </StackPanel>
      </Border>
      <ScrollViewer x:Name="ReviewScroll" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <Border Style="{StaticResource StatusBanner}" AutomationProperties.AutomationId="RelationshipBlockers" Tag="Warning" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="Blocking differences — resolve these before approving" Style="{StaticResource SectionTitleText}" Margin="0,0,0,10" />
              <ItemsControl ItemsSource="{Binding Blockers}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{DynamicResource PrimaryText}" Margin="0,3" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource WorkflowCard}">
            <StackPanel>
              <TextBlock Text="Relationship state" Style="{StaticResource SectionTitleText}" Margin="0,0,0,10" />
              <controls:StatusBadge Style="{StaticResource WorkflowState}" Label="{Binding Detail.Summary.State, TargetNullValue=Select a candidate, FallbackValue=Select a candidate}" Margin="0,0,8,6" />
              <TextBox Text="{Binding Detail.Summary.Id, Mode=OneWay}" IsReadOnly="True" AutomationProperties.Name="Relationship ID for explicit opportunity evaluation" ToolTip="Copy this ID to Evaluate Selected on the Opportunities page" />
              <ItemsControl ItemsSource="{Binding Detail.Warnings}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Style="{StaticResource MutedText}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <WrapPanel Margin="0,8">
                <Button Content="Revalidate" Command="{Binding RevalidateCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,6" VerticalAlignment="Bottom" />
                <Button Content="Enrich public metadata" Command="{Binding EnrichCommand}" Margin="0,0,8,6" Style="{StaticResource SecondaryButton}" VerticalAlignment="Bottom" />
              </WrapPanel>
            </StackPanel>
          </Border>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource InsetPanel}" Grid.Column="0" Margin="0,0,8,0">
              <StackPanel>
                <TextBlock Text="Source market" Style="{StaticResource SectionTitleText}" Margin="0,0,0,10" />
                <TextBlock Text="{Binding Detail.Source.Title}" FontWeight="Bold" TextWrapping="Wrap" Foreground="{DynamicResource PrimaryText}" />
                <TextBlock Text="{Binding Detail.Source.NativeId}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Detail.Source.Rules, TargetNullValue=Rules unavailable}" TextWrapping="Wrap" Foreground="{DynamicResource PrimaryText}" Margin="0,6" />
                <TextBlock Text="{Binding Detail.Source.ResolutionSource, TargetNullValue=Resolution source unknown}" TextWrapping="Wrap" Style="{StaticResource MutedText}" />
                <TextBlock Text="{Binding Detail.Source.MarketClose, StringFormat=Market close (not deadline): {0}}" TextWrapping="Wrap" Style="{StaticResource MutedText}" />
                <TextBlock Text="{Binding Detail.Source.ExpectedResolution, StringFormat=Expected resolution: {0}}" TextWrapping="Wrap" Style="{StaticResource MutedText}" />
                <Expander Header="Raw metadata and parsed semantics">
                  <TextBox Text="{Binding Detail.Source.SemanticDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" />
                </Expander>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource InsetPanel}" Grid.Column="1" Margin="0">
              <StackPanel>
                <TextBlock Text="Target market" Style="{StaticResource SectionTitleText}" Margin="0,0,0,10" />
                <TextBlock Text="{Binding Detail.Target.Title}" FontWeight="Bold" TextWrapping="Wrap" Foreground="{DynamicResource PrimaryText}" />
                <TextBlock Text="{Binding Detail.Target.NativeId}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Detail.Target.Rules, TargetNullValue=Rules unavailable}" TextWrapping="Wrap" Foreground="{DynamicResource PrimaryText}" Margin="0,6" />
                <TextBlock Text="{Binding Detail.Target.ResolutionSource, TargetNullValue=Resolution source unknown}" TextWrapping="Wrap" Style="{StaticResource MutedText}" />
                <TextBlock Text="{Binding Detail.Target.MarketClose, StringFormat=Market close (not deadline): {0}}" TextWrapping="Wrap" Style="{StaticResource MutedText}" />
                <TextBlock Text="{Binding Detail.Target.ExpectedResolution, StringFormat=Expected resolution: {0}}" TextWrapping="Wrap" Style="{StaticResource MutedText}" />
                <Expander Header="Raw metadata and parsed semantics">
                  <TextBox Text="{Binding Detail.Target.SemanticDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" />
                </Expander>
              </StackPanel>
            </Border>
          </Grid>
          <Expander Header="All evidence and persisted outcome mappings" Margin="0,8">
            <StackPanel>
              <ItemsControl ItemsSource="{Binding Detail.Evidence}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Foreground="{DynamicResource PrimaryText}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ItemsControl ItemsSource="{Binding Detail.Mappings}" />
            </StackPanel>
          </Expander>
          <Border Style="{StaticResource WorkflowCard}">
            <StackPanel>
              <TextBlock Text="Manual review and outcome mappings" Style="{StaticResource SectionTitleText}" Margin="0,0,0,10" />
              <TextBlock Text="Explicit manual outcome mapping (native IDs; no label-based defaults)" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" TextWrapping="Wrap" />
              <ItemsControl ItemsSource="{Binding MappingEditors}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <WrapPanel Margin="0,3">
                      <TextBlock Text="{Binding Source.Label}" Width="70" Foreground="{DynamicResource PrimaryText}" />
                      <TextBlock Text="{Binding Source.NativeId}" Width="160" TextWrapping="Wrap" Foreground="{DynamicResource PrimaryText}" />
                      <ComboBox ItemsSource="{Binding Targets}" SelectedItem="{Binding Target}" DisplayMemberPath="NativeId" Width="170" AutomationProperties.Name="Mapped target native outcome" />
                      <ComboBox ItemsSource="{Binding DataContext.ReviewTypes, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding Type}" Width="220" Margin="6,0" AutomationProperties.Name="Mapping relationship" />
                    </WrapPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ComboBox ItemsSource="{Binding ReviewTypes}" SelectedItem="{Binding ReviewType}" Width="260" HorizontalAlignment="Left" Margin="0,6" AutomationProperties.Name="Manual relationship type" />
              <TextBlock Text="Set facts apply only to the union of native outcomes explicitly mapped above." TextWrapping="Wrap" Style="{StaticResource MutedText}" />
              <WrapPanel Margin="0,6">
                <TextBlock Text="Mutually exclusive" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryText}" />
                <ComboBox ItemsSource="{Binding TruthValues}" SelectedItem="{Binding MutuallyExclusive}" Width="100" Margin="8,0" AutomationProperties.Name="Mutually exclusive set fact" />
                <TextBlock Text="Collectively exhaustive" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryText}" />
                <ComboBox ItemsSource="{Binding TruthValues}" SelectedItem="{Binding CollectivelyExhaustive}" Width="100" Margin="8,0" AutomationProperties.Name="Collectively exhaustive set fact" />
              </WrapPanel>
              <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" MaxLength="2000" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="55" AutomationProperties.Name="Required review reason" />
              <WrapPanel Margin="0,8">
                <Button Content="Verify Manually…" Command="{Binding VerifyCommand}" IsEnabled="{Binding CanReview}" Style="{StaticResource SuccessButton}" Margin="0,0,8,6" VerticalAlignment="Bottom" />
                <Button Content="Reject…" Command="{Binding RejectCommand}" IsEnabled="{Binding CanReview}" Margin="0,0,8,6" Style="{StaticResource DangerButton}" VerticalAlignment="Bottom" />
              </WrapPanel>
              <TextBlock Text="{Binding Detail.ReviewReason}" TextWrapping="Wrap" Style="{StaticResource MutedText}" />
              <TextBlock Text="{Binding Detail.ReviewerId, StringFormat=Reviewer: {0}}" Style="{StaticResource MutedText}" />
              <Expander Header="Source fingerprint / policy diagnostics">
                <StackPanel>
                  <TextBlock Text="{Binding Detail.SourceFingerprint}" TextWrapping="Wrap" Style="{StaticResource MutedText}" />
                  <TextBlock Text="{Binding Detail.TargetFingerprint}" TextWrapping="Wrap" Style="{StaticResource MutedText}" />
                  <TextBlock Text="{Binding Detail.PolicyVersion, StringFormat=Policy version: {0}}" Style="{StaticResource MutedText}" />
                </StackPanel>
              </Expander>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </StackPanel>
  </ScrollViewer>
</UserControl>
