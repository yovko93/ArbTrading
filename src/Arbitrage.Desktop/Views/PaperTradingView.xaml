<UserControl x:Class="Arbitrage.Desktop.Views.PaperTradingView" Language="en-US"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Arbitrage.Desktop.Views" xmlns:controls="clr-namespace:Arbitrage.Desktop.Controls">
 <UserControl.Resources>
  <controls:StatusToneConverter x:Key="StatusTone" />
  <controls:PaperBalanceConverter x:Key="PaperBalance" />
  <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}"><Setter Property="RowHeight" Value="30"/><Setter Property="ColumnHeaderHeight" Value="32"/><Setter Property="GridLinesVisibility" Value="None"/><Setter Property="HeadersVisibility" Value="Column"/></Style>
  <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="Padding" Value="8,4"/></Style>
 </UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel MaxWidth="1160" HorizontalAlignment="Stretch">
      <TextBlock Text="Paper request in progress…" Style="{StaticResource BusyText}" Visibility="{Binding Busy, Converter={StaticResource BooleanToVisibility}}" AutomationProperties.LiveSetting="Polite" />
   <DockPanel Margin="0,0,0,6">
    <controls:StatusBadge DockPanel.Dock="Right" Label="SIMULATION ONLY" Tone="Info" VerticalAlignment="Center"/>
    <TextBlock Text="Paper Trading" Style="{StaticResource PageTitleText}"/>
   </DockPanel>
   <TextBlock Text="Mode: Paper. No real orders submitted. Explicit snapshot entries. Review holdings and settlement in Portfolio." Style="{StaticResource PageSubtitleText}" Margin="0,0,0,14"/>
   <Border Style="{StaticResource NoticeBanner}" ToolTip="{Binding Notice}" Margin="0,0,0,16"><TextBlock Text="{Binding Notice}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/></Border>
   <Border Style="{StaticResource CardBorder}"><StackPanel>
    <TextBlock Text="Paper capital" Style="{StaticResource SectionTitleText}" Margin="0,0,0,12"/>
    <Border Style="{StaticResource InsetPanel}" Margin="0,0,0,14">
     <StackPanel>
      <DockPanel><TextBlock Text="Active generation" FontWeight="SemiBold"/>
       <controls:StatusBadge HorizontalAlignment="Right" Label="{Binding Account.Generation.Integrity, TargetNullValue=Unavailable, FallbackValue=Unavailable}" Tone="{Binding Account.Generation.Integrity, Converter={StaticResource StatusTone}}"/>
      </DockPanel>
      <TextBlock Text="{Binding AccountText}" Margin="0,6,0,0">
       <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Account.Generation}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
      </TextBlock>
      <TextBlock Text="{Binding Account.Generation.Id, StringFormat='Generation ID: {0}', TargetNullValue=No active generation, FallbackValue=No active generation}" Style="{StaticResource MutedText}" Margin="0,6,0,0"/>
      <WrapPanel Margin="0,6,0,0"><TextBlock Text="{Binding Account.State, StringFormat='State: {0}'}" Margin="0,0,18,0"/><TextBlock Text="{Binding Account.Generation.CreatedAt, StringFormat='Created at: {0:O}', TargetNullValue=Created at: unavailable, FallbackValue=Created at: unavailable}" Style="{StaticResource MutedText}"/></WrapPanel>
     </StackPanel>
    </Border>
    <UniformGrid Columns="2" AutomationProperties.Name="Execution funding available">
     <Border Style="{StaticResource SummaryCard}" BorderBrush="{DynamicResource SemanticBrush.InfoBorder}" Margin="0,0,7,0">
      <StackPanel DataContext="{Binding Account.Balances, Converter={StaticResource PaperBalance}, ConverterParameter=Kalshi/USD}">
       <TextBlock Text="Kalshi / USD" FontWeight="SemiBold"/>
       <TextBlock Text="Available for entry" Style="{StaticResource MutedText}" Margin="0,7,0,3"/>
       <TextBlock Text="{Binding AvailableCash, TargetNullValue=Unavailable, FallbackValue=Unavailable}" Style="{StaticResource LargeMetricText}"/>
       <TextBlock Text="USD · simulated funds" Style="{StaticResource MutedText}" Margin="0,6,0,0"/>
      </StackPanel>
     </Border>
     <Border Style="{StaticResource SummaryCard}" BorderBrush="{DynamicResource SemanticBrush.SuccessBorder}" Margin="7,0,0,0">
      <StackPanel DataContext="{Binding Account.Balances, Converter={StaticResource PaperBalance}, ConverterParameter=Polymarket/USDC}">
       <TextBlock Text="Polymarket / USDC" FontWeight="SemiBold"/>
       <TextBlock Text="Available for entry" Style="{StaticResource MutedText}" Margin="0,7,0,3"/>
       <TextBlock Text="{Binding AvailableCash, TargetNullValue=Unavailable, FallbackValue=Unavailable}" Style="{StaticResource LargeMetricText}"/>
       <TextBlock Text="USDC · simulated funds" Style="{StaticResource MutedText}" Margin="0,6,0,0"/>
      </StackPanel>
     </Border>
    </UniformGrid>
   </StackPanel></Border>

   <UniformGrid Columns="2" Margin="0,0,0,16">
    <Border Style="{StaticResource SummaryCard}" Margin="0,0,7,0" AutomationProperties.AutomationId="RiskPolicySummary">
     <StackPanel>
      <TextBlock Text="SAVED POLICY" Style="{StaticResource EyebrowText}"/>
      <TextBlock Text="Risk Policy" Style="{StaticResource SectionTitleText}" Margin="0,5,0,10"/>
      <controls:StatusBadge HorizontalAlignment="Left" Label="{Binding RiskStatus.State, TargetNullValue=Unavailable, FallbackValue=Unavailable}" Tone="{Binding RiskStatus.State, Converter={StaticResource StatusTone}}"/>
      <UniformGrid Columns="2" Margin="0,16,0,14">
       <StackPanel><TextBlock Text="Cash reserve" Style="{StaticResource FieldLabel}"/><TextBlock AutomationProperties.AutomationId="SavedCashReserve" Text="{Binding RiskStatus.Policy.Limits.MinimumCashReserveFraction, StringFormat={}{0:0.############################%}, TargetNullValue=Unavailable, FallbackValue=Unavailable}" Style="{StaticResource MetricText}"/></StackPanel>
       <StackPanel><TextBlock Text="Max open executions" Style="{StaticResource FieldLabel}"/><TextBlock AutomationProperties.AutomationId="SavedExecutionLimit" Text="{Binding RiskStatus.Policy.Limits.MaximumOpenExecutions, TargetNullValue=Unavailable, FallbackValue=Unavailable}" Style="{StaticResource MetricText}"/></StackPanel>
      </UniformGrid>
      <TextBlock Text="{Binding RiskStatus.Policy.Revision, StringFormat='Revision: {0}', TargetNullValue=No saved policy, FallbackValue=No saved policy}" ToolTip="{Binding RiskStatus.Policy.Revision}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
      <TextBlock Text="Limits apply to new paper entries. Full policy and editor below." Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
     </StackPanel>
    </Border>
    <Border Style="{StaticResource SummaryCard}" Margin="7,0,0,0" AutomationProperties.AutomationId="AutoPaperSummary">
     <StackPanel>
      <TextBlock Text="SAVED PROFILE / SESSION" Style="{StaticResource EyebrowText}"/>
      <TextBlock Text="Auto Paper" Style="{StaticResource SectionTitleText}" Margin="0,5,0,10"/>
      <WrapPanel>
       <controls:StatusBadge Label="{Binding AutomationStatus.State, TargetNullValue=Unavailable, FallbackValue=Unavailable}" Tone="{Binding AutomationStatus.State, Converter={StaticResource StatusTone}}" Margin="0,0,7,5"/>
       <controls:StatusBadge Margin="0,0,0,5">
        <controls:StatusBadge.Style><Style TargetType="controls:StatusBadge"><Setter Property="Label" Value="Kill switch: unknown"/><Setter Property="Tone" Value="Neutral"/><Style.Triggers>
         <DataTrigger Binding="{Binding AutomationStatus.KillSwitch.IsLatched}" Value="False"><Setter Property="Label" Value="Kill switch: clear"/><Setter Property="Tone" Value="Good"/></DataTrigger>
         <DataTrigger Binding="{Binding AutomationStatus.KillSwitch.IsLatched}" Value="True"><Setter Property="Label" Value="Kill switch: latched"/><Setter Property="Tone" Value="Error"/></DataTrigger>
        </Style.Triggers></Style></controls:StatusBadge.Style>
       </controls:StatusBadge>
      </WrapPanel>
      <UniformGrid Columns="2" Margin="0,11,0,14">
       <StackPanel><TextBlock Text="Saved sizing mode" Style="{StaticResource FieldLabel}"/>
        <TextBlock AutomationProperties.AutomationId="SavedSizingMode">
         <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Text" Value="{Binding AutomationStatus.Profile.Settings.SizingMode, TargetNullValue=Unavailable, FallbackValue=Unavailable}"/><Style.Triggers>
          <DataTrigger Binding="{Binding AutomationStatus.Profile.Settings.SizingMode}" Value="FixedQuantity"><Setter Property="Text" Value="Fixed quantity"/></DataTrigger>
          <DataTrigger Binding="{Binding AutomationStatus.Profile.Settings.SizingMode}" Value="LargestAdmissibleGridQuantity"><Setter Property="Text" Value="Adaptive grid"/></DataTrigger>
         </Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
       </StackPanel>
       <StackPanel><TextBlock Text="Per-session cap" Style="{StaticResource FieldLabel}"/><TextBlock AutomationProperties.AutomationId="SavedAutomationCap" Text="{Binding AutomationStatus.Profile.Settings.MaximumExecutionsPerSession, TargetNullValue=Unavailable, FallbackValue=Unavailable}" Style="{StaticResource MetricText}"/></StackPanel>
      </UniformGrid>
      <TextBlock Text="{Binding AutomationStatus.Profile.Revision, StringFormat='Revision: {0}', TargetNullValue=No saved profile, FallbackValue=No saved profile}" ToolTip="{Binding AutomationStatus.Profile.Revision}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
      <TextBlock Text="Explicit arming required. Session controls and profile editor below." Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
     </StackPanel>
    </Border>
   </UniformGrid>

   <TextBlock Text="Configuration and controls" Style="{StaticResource SectionTitleText}" Margin="0,8,0,6"/>
   <TextBlock Text="Review saved state above. Editing a field does not activate a policy or arm a session." Style="{StaticResource PageSubtitleText}" Margin="0,0,0,16"/>
   <Border Style="{StaticResource CardBorder}"><StackPanel>
    <TextBlock Text="Initialize / Reset paper generation" Style="{StaticResource SectionTitleText}"/>
    <TextBlock Text="Review initial amounts and reason before confirming a generation change." Style="{StaticResource MutedText}" Margin="0,4,0,4"/>
    <WrapPanel Margin="0,8">
     <StackPanel Margin="0,0,12,8"><TextBlock Text="Initial Kalshi USD"/><TextBox Text="{Binding KalshiStartingCash, UpdateSourceTrigger=PropertyChanged}" Width="150" AutomationProperties.Name="Initial Kalshi USD"/></StackPanel>
     <StackPanel Margin="0,0,12,8"><TextBlock Text="Initial Polymarket USDC"/><TextBox Text="{Binding PolymarketStartingCash, UpdateSourceTrigger=PropertyChanged}" Width="150" AutomationProperties.Name="Initial Polymarket USDC"/></StackPanel>
     <StackPanel Margin="0,0,0,8"><TextBlock Text="Initialization / reset reason"/><TextBox Text="{Binding ResetReason, UpdateSourceTrigger=PropertyChanged}" Width="320" AutomationProperties.Name="Paper generation reason"/></StackPanel>
    </WrapPanel>
    <WrapPanel><Button Style="{StaticResource DangerButton}" Margin="0,0,8,6" Content="Initialize / Reset paper generation…" Command="{Binding InitializeCommand}"/><Button Style="{StaticResource PrimaryButton}" Content="Refresh paper account" Command="{Binding RefreshCommand}" Margin="0,0,0,6"/></WrapPanel>
   </StackPanel></Border>
   <views:PaperRiskView/>
   <views:PaperAutomationView/>
   <Border Style="{StaticResource CardBorder}"><StackPanel>
    <TextBlock Text="EXPLICIT PAPER ENTRY" Style="{StaticResource EyebrowText}" Margin="0,0,0,6"/>
    <TextBlock Text="Explicit snapshot preview" Style="{StaticResource SectionTitleText}" Margin="0,0,0,8"/>
    <TextBlock Text="Select Paper preview on a current opportunity. USD and USDC are separate; no conversion is assumed." TextWrapping="Wrap"/>
    <TextBlock Text="{Binding OpportunityKey}" TextWrapping="Wrap" Margin="0,8"/>
    <WrapPanel><TextBlock Text="Requested quantity" VerticalAlignment="Center"/><TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="120" Margin="8,0" AutomationProperties.Name="Paper requested quantity"/>
     <Button Style="{StaticResource SecondaryButton}" Margin="0,0,8,6" Content="Create paper preview" Command="{Binding PreviewCommand}"/><Button Style="{StaticResource PrimaryButton}" Content="Confirm paper execution…" Command="{Binding ExecuteCommand}" Margin="0,0,0,6"/></WrapPanel>
    <TextBlock Text="{Binding PreviewText}" TextWrapping="Wrap" Margin="0,10"/>
    <DataGrid ItemsSource="{Binding Preview.Fills}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MaxHeight="180" AutomationProperties.Name="Preview snapshot fills">
     <DataGrid.Columns><DataGridTextColumn Header="Venue" Binding="{Binding Exchange}" Width="120"/><DataGridTextColumn Header="Instrument" Binding="{Binding InstrumentId}" Width="150"/><DataGridTextColumn Header="Outcome" Binding="{Binding Outcome}" Width="110"/><DataGridTextColumn Header="BUY quantity" Binding="{Binding Quantity}" Width="110"/><DataGridTextColumn Header="Price" Binding="{Binding Price}" Width="100"/><DataGridTextColumn Header="Modeled fee" Binding="{Binding Fee}" Width="120"/><DataGridTextColumn Header="Currency" Binding="{Binding Currency}" Width="90"/><DataGridTextColumn Header="Liquidity origin" Binding="{Binding LiquidityOrigin}" Width="180"/><DataGridTextColumn Header="Book version" Binding="{Binding BookVersion}" Width="120"/></DataGrid.Columns>
    </DataGrid>
   </StackPanel></Border>
  </StackPanel>
 </ScrollViewer>
</UserControl>
