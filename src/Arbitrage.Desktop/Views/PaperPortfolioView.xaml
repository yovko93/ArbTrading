<UserControl x:Class="Arbitrage.Desktop.Views.PaperPortfolioView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="clr-namespace:Arbitrage.Desktop.Views"
 xmlns:controls="clr-namespace:Arbitrage.Desktop.Controls">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
  <ResourceDictionary Source="/Arbitrage.Desktop;component/Resources/Styles/MarketWorkflow.xaml"/>
 </ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel>
   <controls:SectionHeader Title="Portfolio" Subtitle="Simulated holdings and accounting only. These are not exchange assets. USD and USDC remain separate."/>
   <WrapPanel Margin="0,0,0,12"><controls:StatusBadge Label="SIMULATION ONLY" Tone="Info" Margin="0,0,12,8"/><Button Content="Refresh portfolio" Command="{Binding RefreshCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,0,8"/></WrapPanel>
   <Border Style="{StaticResource WorkflowNotice}" ToolTip="{Binding Notice}"><TextBlock Text="{Binding Notice}" TextWrapping="Wrap"/></Border>
   <Border Style="{StaticResource WorkflowCard}" AutomationProperties.AutomationId="PortfolioGeneration"><StackPanel>
    <TextBlock Text="Paper generation" Style="{StaticResource SectionTitleText}"/>
    <WrapPanel Margin="0,10,0,4">
     <StackPanel Style="{StaticResource WorkflowField}"><TextBlock Text="ACCOUNT STATE" Style="{StaticResource EyebrowText}"/><controls:StatusBadge Label="{Binding Account.State, TargetNullValue=Unavailable, FallbackValue=Unavailable}" Style="{StaticResource WorkflowState}" Margin="0,6,0,0"/></StackPanel>
     <StackPanel Style="{StaticResource WorkflowField}"><TextBlock Text="INTEGRITY" Style="{StaticResource EyebrowText}"/><controls:StatusBadge Label="{Binding Account.Generation.Integrity, TargetNullValue=Unavailable, FallbackValue=Unavailable}" Style="{StaticResource WorkflowState}" Margin="0,6,0,0"/></StackPanel>
    </WrapPanel>
    <TextBlock Text="{Binding AccountText}" TextWrapping="Wrap"/>
   </StackPanel></Border>
   <TextBlock Text="Venue balances" Style="{StaticResource SectionTitleText}" Margin="0,0,0,8"/>
   <ItemsControl ItemsSource="{Binding Account.Balances}" AutomationProperties.AutomationId="PortfolioVenueCards">
    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource WorkflowMetric}" Width="262"><StackPanel>
     <WrapPanel><TextBlock Text="{Binding Exchange}" Style="{StaticResource SectionTitleText}" Margin="0,0,8,0"/><controls:StatusBadge Label="{Binding Currency}" Tone="Neutral"/></WrapPanel>
     <TextBlock Text="AVAILABLE CASH" Style="{StaticResource EyebrowText}" Margin="0,12,0,4"/>
     <TextBlock Text="{Binding AvailableCash}" Style="{StaticResource MetricText}"/>
     <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock Text="Initial cash" Style="{StaticResource MutedText}"/><TextBlock Grid.Column="1" Text="{Binding InitialCash}"/>
      <TextBlock Grid.Row="1" Text="Reserved cash" Style="{StaticResource MutedText}" Margin="0,5,0,0"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ReservedCash}" Margin="0,5,0,0"/>
      <TextBlock Grid.Row="2" Text="Total cash" Style="{StaticResource MutedText}" Margin="0,5,0,0"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TotalCash}" Margin="0,5,0,0"/>
     </Grid>
    </StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate>
   </ItemsControl>
<Border AutomationProperties.AutomationId="PortfolioUnavailable"><Border.Style><Style TargetType="Border" BasedOn="{StaticResource WorkflowEmpty}"><Style.Triggers><DataTrigger Binding="{Binding Account.Generation}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="Portfolio balances unavailable until an authorized paper generation is available. The current account status and notice are shown above." TextWrapping="Wrap" Style="{StaticResource MutedText}"/></Border>
   <Expander Header="Exact venue balance rows" Style="{StaticResource DetailsExpander}">
<DataGrid ItemsSource="{Binding Account.Balances}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MaxHeight="160" AutomationProperties.Name="Paper venue balances">
     <DataGrid.Columns><DataGridTextColumn Header="Venue" Binding="{Binding Exchange}" Width="130"/><DataGridTextColumn Header="Currency" Binding="{Binding Currency}" Width="100"/><DataGridTextColumn Header="Initial cash" Binding="{Binding InitialCash}" Width="130"/><DataGridTextColumn Header="Available cash" Binding="{Binding AvailableCash}" Width="150"/><DataGridTextColumn Header="Reserved" Binding="{Binding ReservedCash}" Width="130"/><DataGridTextColumn Header="Total cash" Binding="{Binding TotalCash}" Width="150"/></DataGrid.Columns>
    </DataGrid>
   </Expander>
   <Expander Header="Positions, settlement and realized performance" IsExpanded="True" Style="{StaticResource DetailsExpander}" AutomationProperties.AutomationId="PortfolioPositionsSection"><views:PaperSettlementView/></Expander>
   <Expander Header="Current executable valuation" IsExpanded="True" Style="{StaticResource DetailsExpander}" AutomationProperties.AutomationId="PortfolioValuationSection"><views:PaperValuationView/></Expander>
   <Expander Header="Paper execution history" IsExpanded="True" Style="{StaticResource DetailsExpander}" AutomationProperties.AutomationId="PortfolioExecutionHistory"><StackPanel>
    <TextBlock Text="All retained generations" Style="{StaticResource SectionTitleText}"/>
    <TextBlock Text="Historical paper fills and execution proof. Select an execution to inspect its venue, currency, native market and instrument IDs." TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,6,0,8"/>
<DataGrid ItemsSource="{Binding Executions}" SelectedItem="{Binding SelectedExecution}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MaxHeight="240" AutomationProperties.Name="Paper execution history" Margin="0,8">
    <DataGrid.Columns><DataGridTextColumn Header="UTC" Binding="{Binding CreatedAt}" Width="180"/><DataGridTextColumn Header="Origin" Binding="{Binding Origin}" Width="130"/><DataGridTextColumn Header="State" Binding="{Binding State}"/><DataGridTextColumn Header="Sizing" Binding="{Binding SizingText}" Width="320"/><DataGridTextColumn Header="Cost with fees" Binding="{Binding Cost}"/><DataGridTextColumn Header="Expected profit at resolution" Binding="{Binding ExpectedProfitAtResolution}" Width="200"/><DataGridTextColumn Header="Generation" Binding="{Binding GenerationId}" Width="240"/></DataGrid.Columns>
   </DataGrid><Border AutomationProperties.AutomationId="PortfolioExecutionsEmpty"><Border.Style><Style TargetType="Border" BasedOn="{StaticResource WorkflowEmpty}"><Style.Triggers><DataTrigger Binding="{Binding Executions.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="No paper executions are available on this history page." TextWrapping="Wrap" Style="{StaticResource MutedText}"/></Border>
    <WrapPanel Margin="0,8,0,0"><Button Content="Previous history" Command="{Binding PreviousHistoryCommand}" Margin="0,0,8,8"/><TextBlock Text="{Binding HistoryPage}" Margin="4,0,12,8" VerticalAlignment="Center"/><Button Content="Next history" Command="{Binding NextHistoryCommand}" Margin="0,0,0,8"/></WrapPanel>
    <Border Style="{StaticResource InsetPanel}" Padding="12"><TextBlock Text="{Binding ExecutionText}" TextWrapping="Wrap"/></Border>
   </StackPanel></Expander>
  </StackPanel>
 </ScrollViewer>
</UserControl>
