<UserControl x:Class="Arbitrage.Desktop.Controls.EmptyState"
             x:Name="Root" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border Style="{StaticResource CardBorder}">
    <StackPanel>
      <TextBlock Text="{Binding Title, ElementName=Root}" Style="{StaticResource SectionTitleText}" />
      <TextBlock Text="{Binding Purpose, ElementName=Root}" Margin="0,10,0,6" />
      <TextBlock Text="{Binding Dependency, ElementName=Root}" Style="{StaticResource MutedText}" />
      <TextBlock Text="No operational data is being generated for this module." Style="{StaticResource MutedText}" Margin="0,16,0,0" />
    </StackPanel>
  </Border>
</UserControl>
