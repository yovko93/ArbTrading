<UserControl x:Class="Arbitrage.Desktop.Views.PaperSettlementView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="clr-namespace:Arbitrage.Desktop.Views"
 xmlns:controls="clr-namespace:Arbitrage.Desktop.Controls">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
  <ResourceDictionary Source="/Arbitrage.Desktop;component/Resources/Styles/MarketWorkflow.xaml"/>
 </ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <StackPanel>
  <Border Style="{StaticResource WorkflowNotice}" ToolTip="{Binding Notice}"><TextBlock Text="{Binding Notice}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/></Border>
  <WrapPanel Margin="0,0,0,10">
   <StackPanel Style="{StaticResource WorkflowField}"><TextBlock Text="Paper generation" Style="{StaticResource MutedText}" Margin="0,0,0,4"/><ComboBox ItemsSource="{Binding Account.History}" SelectedItem="{Binding SettlementGeneration}" Width="320" AutomationProperties.Name="Settlement generation"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Id}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
   <Button Content="Refresh settlement data" Command="{Binding RefreshSettlementCommand}" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" Margin="0,0,0,8"/>
  </WrapPanel>
  <Border Style="{StaticResource WorkflowCard}" AutomationProperties.AutomationId="PortfolioPositionHistory"><StackPanel>
   <TextBlock Text="Paper position history" Style="{StaticResource SectionTitleText}"/>
   <TextBlock Text="Original quantity, native market/instrument IDs and fee-inclusive cost retained. Settlement values remain unavailable for open positions." TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,6,0,10"/>
   <WrapPanel>
    <StackPanel Style="{StaticResource WorkflowField}"><TextBlock Text="Position status" Style="{StaticResource MutedText}" Margin="0,0,0,4"/><ComboBox ItemsSource="{Binding PositionFilters}" SelectedItem="{Binding PositionFilter}" Width="140" AutomationProperties.Name="Position status filter"/></StackPanel>
    <Button Content="Refresh positions" Command="{Binding RefreshSettlementCommand}" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" Margin="0,0,8,8"/>
   </WrapPanel>
<DataGrid ItemsSource="{Binding PositionHistory}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MaxHeight="180" AutomationProperties.Name="Open and settled paper positions">
   <DataGrid.Columns><DataGridTextColumn Header="Venue" Binding="{Binding Exchange}" Width="120"/><DataGridTextColumn Header="Currency" Binding="{Binding Currency}" Width="90"/><DataGridTextColumn Header="Market" Binding="{Binding MarketId}" Width="210"/><DataGridTextColumn Header="Instrument" Binding="{Binding InstrumentId}" Width="180"/><DataGridTextColumn Header="Outcome" Binding="{Binding Outcome}" Width="90"/><DataGridTemplateColumn Header="State" Width="135"><DataGridTemplateColumn.CellTemplate><DataTemplate><controls:StatusBadge Label="{Binding Status}" Style="{StaticResource WorkflowState}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="90"/><DataGridTextColumn Header="Cost basis" Binding="{Binding CostBasis}" Width="110"/><DataGridTextColumn Header="Fees" Binding="{Binding Fees}" Width="100"/><DataGridTextColumn Header="Payout" Binding="{Binding SettlementPayout, TargetNullValue=Unavailable}" Width="90"/><DataGridTextColumn Header="Realized P&amp;L" Binding="{Binding RealizedPnl, TargetNullValue=Unavailable}" Width="130"/><DataGridTextColumn Header="Settled UTC" Binding="{Binding SettledAt, TargetNullValue=Unavailable}" Width="180"/><DataGridTextColumn Header="Source" Binding="{Binding ResolutionSource}" Width="140"/></DataGrid.Columns>
  </DataGrid><Border AutomationProperties.AutomationId="PortfolioPositionsEmpty"><Border.Style><Style TargetType="Border" BasedOn="{StaticResource WorkflowEmpty}"><Style.Triggers><DataTrigger Binding="{Binding PositionHistory.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="No positions are available for the selected generation, status filter and page." TextWrapping="Wrap" Style="{StaticResource MutedText}"/></Border>
   <WrapPanel Margin="0,8,0,0"><Button Content="Previous positions" Command="{Binding PreviousPositionsCommand}" Margin="0,0,8,8"/><TextBlock Text="{Binding PositionPage}" Margin="4,0,12,8" VerticalAlignment="Center"/><Button Content="Next positions" Command="{Binding NextPositionsCommand}" Margin="0,0,0,8"/></WrapPanel>
  </StackPanel></Border>
  <Border Style="{StaticResource WorkflowCard}" AutomationProperties.AutomationId="PortfolioManualResolution"><StackPanel>
   <TextBlock Text="Simulated Resolution · MANUAL PAPER SCENARIO" Style="{StaticResource SectionTitleText}"/>
   <Border Style="{StaticResource StatusBanner}" Tag="Warning" Margin="0,10,0,12"><TextBlock Text="PAPER SIMULATION ONLY. This does not report or alter the real exchange. Confirmed scenarios cannot be changed; use another generation to test another outcome." TextWrapping="Wrap"/></Border>
   <WrapPanel>
    <StackPanel Style="{StaticResource WorkflowField}"><TextBlock Text="Unresolved paper market" Style="{StaticResource MutedText}" Margin="0,0,0,4"/><ComboBox ItemsSource="{Binding ResolutionCandidates}" SelectedItem="{Binding SelectedCandidate}" Width="280" AutomationProperties.Name="Unresolved paper market"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding MarketId}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
    <StackPanel Style="{StaticResource WorkflowField}"><TextBlock Text="Simulated winning outcome" Style="{StaticResource MutedText}" Margin="0,0,0,4"/><ComboBox ItemsSource="{Binding SelectedCandidate.Outcomes}" SelectedItem="{Binding WinningOutcome}" Width="180" AutomationProperties.Name="Simulated winning outcome"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Outcome}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
   </WrapPanel>
   <WrapPanel><Button Content="Preview Resolution" Command="{Binding PreviewResolutionCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8"/><Button Content="Confirm Paper Resolution" Command="{Binding ConfirmResolutionCommand}" Style="{StaticResource WarningButton}" Margin="0,0,0,8"/></WrapPanel>
   <WrapPanel Margin="0,4,0,0"><Button Content="Previous markets" Command="{Binding PreviousCandidatesCommand}" Margin="0,0,8,8"/><TextBlock Text="{Binding CandidatePage}" Margin="4,0,12,8" VerticalAlignment="Center"/><Button Content="Next markets" Command="{Binding NextCandidatesCommand}" Margin="0,0,0,8"/></WrapPanel>
   <TextBlock Text="{Binding CandidateText}" TextWrapping="Wrap" Margin="0,4,0,10"/>
   <Border Style="{StaticResource InsetPanel}" Padding="12"><TextBlock Text="{Binding ResolutionPreviewText}" TextWrapping="Wrap"/></Border>
  </StackPanel></Border>
  <Border Style="{StaticResource WorkflowCard}" AutomationProperties.AutomationId="PortfolioSettlementHistory"><StackPanel>
   <TextBlock Text="Settlement history" Style="{StaticResource SectionTitleText}"/>
   <TextBlock Text="Manual Scenario Resolution" Style="{StaticResource MutedText}" Margin="0,6,0,8"/>
<DataGrid ItemsSource="{Binding Resolutions}" SelectedItem="{Binding SelectedResolution}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MaxHeight="150" AutomationProperties.Name="Paper settlement history">
   <DataGrid.Columns><DataGridTextColumn Header="Recorded UTC" Binding="{Binding RecordedAt}" Width="180"/><DataGridTextColumn Header="Venue" Binding="{Binding Exchange}" Width="120"/><DataGridTextColumn Header="Market" Binding="{Binding MarketId}" Width="200"/><DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="140"/><DataGridTextColumn Header="Generation" Binding="{Binding GenerationId}" Width="280"/></DataGrid.Columns>
  </DataGrid><Border AutomationProperties.AutomationId="PortfolioSettlementsEmpty"><Border.Style><Style TargetType="Border" BasedOn="{StaticResource WorkflowEmpty}"><Style.Triggers><DataTrigger Binding="{Binding Resolutions.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="No manual paper settlements are available on this history page." TextWrapping="Wrap" Style="{StaticResource MutedText}"/></Border>
   <WrapPanel Margin="0,8,0,0"><Button Content="Previous settlements" Command="{Binding PreviousSettlementsCommand}" Margin="0,0,8,8"/><TextBlock Text="{Binding SettlementPage}" Margin="4,0,12,8" VerticalAlignment="Center"/><Button Content="Next settlements" Command="{Binding NextSettlementsCommand}" Margin="0,0,0,8"/></WrapPanel>
   <TextBlock Text="{Binding ResolutionDetailText}" TextWrapping="Wrap" Margin="0,4,0,0"/>
  </StackPanel></Border>
  <Border Style="{StaticResource WorkflowCard}" AutomationProperties.AutomationId="PortfolioRealizedPerformance"><StackPanel>
   <TextBlock Text="Paper performance" Style="{StaticResource SectionTitleText}"/>
   <TextBlock Text="Realized accounting values" Style="{StaticResource MutedText}" Margin="0,6,0,8"/>
   <TextBlock Text="{Binding PerformanceText}" TextWrapping="Wrap" Margin="0,0,0,10"/>
<DataGrid ItemsSource="{Binding Performance.Buckets}" SelectedItem="{Binding SelectedBucket}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MaxHeight="180" AutomationProperties.Name="Performance by venue and currency">
   <DataGrid.Columns><DataGridTextColumn Header="Venue" Binding="{Binding Exchange}" Width="120"/><DataGridTextColumn Header="Currency" Binding="{Binding Currency}" Width="90"/><DataGridTextColumn Header="Starting capital" Binding="{Binding StartingCash}" Width="130"/><DataGridTextColumn Header="Current cash" Binding="{Binding CurrentCash}" Width="130"/><DataGridTextColumn Header="Open cost" Binding="{Binding OpenCostBasis}" Width="110"/><DataGridTextColumn Header="Realized P&amp;L" Binding="{Binding CumulativeRealizedPnl}" Width="130"/><DataGridTextColumn Header="Open executions" Binding="{Binding CommittedExecutionCount}" Width="140"/><DataGridTextColumn Header="Partial" Binding="{Binding PartiallySettledExecutionCount}" Width="80"/><DataGridTextColumn Header="Settled" Binding="{Binding SettledExecutionCount}" Width="80"/></DataGrid.Columns>
  </DataGrid><Border AutomationProperties.AutomationId="PortfolioPerformanceEmpty"><Border.Style><Style TargetType="Border" BasedOn="{StaticResource WorkflowEmpty}"><Style.Triggers><DataTrigger Binding="{Binding Performance}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="Realized performance unavailable for the selected generation." TextWrapping="Wrap" Style="{StaticResource MutedText}"/></Border>
   <WrapPanel Margin="0,12,0,4"><TextBlock Text="Selected series:" VerticalAlignment="Center" Margin="0,0,8,8"/><TextBlock Text="{Binding SelectedBucket.Exchange}" VerticalAlignment="Center" Margin="0,0,8,8"/><TextBlock Text="{Binding SelectedBucket.Currency}" VerticalAlignment="Center" Margin="0,0,12,8"/><Button Content="Load selected curve" Command="{Binding RefreshCurveCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,0,8"/></WrapPanel>
   <views:PaperPerformanceChart Points="{Binding CurvePoints}" Height="100" Margin="0,8" AutomationProperties.Name="Realized performance curve; exact values in following table"/>
<Border AutomationProperties.AutomationId="PortfolioCurveEmpty"><Border.Style><Style TargetType="Border" BasedOn="{StaticResource WorkflowEmpty}"><Style.Triggers><DataTrigger Binding="{Binding CurvePoints.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="No realized performance series is available on this page. Load a selected venue/currency series when available." TextWrapping="Wrap" Style="{StaticResource MutedText}"/></Border><DataGrid ItemsSource="{Binding CurvePoints}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MaxHeight="180" AutomationProperties.Name="Realized performance and cash curve values">
   <DataGrid.Columns><DataGridTextColumn Header="UTC" Binding="{Binding Timestamp}" Width="180"/><DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="170"/><DataGridTextColumn Header="Cash" Binding="{Binding CashAvailable}" Width="120"/><DataGridTextColumn Header="Realized delta" Binding="{Binding RealizedPnlDelta}" Width="130"/><DataGridTextColumn Header="Cumulative P&amp;L" Binding="{Binding CumulativeRealizedPnl}" Width="140"/><DataGridTextColumn Header="Realized performance" Binding="{Binding RealizedPerformance}" Width="180"/></DataGrid.Columns>
  </DataGrid>
   <WrapPanel Margin="0,8,0,0"><Button Content="Previous curve" Command="{Binding PreviousCurveCommand}" Margin="0,0,8,8"/><TextBlock Text="{Binding CurvePage}" Margin="4,0,12,8" VerticalAlignment="Center"/><Button Content="Next curve" Command="{Binding NextCurveCommand}" Margin="0,0,0,8"/></WrapPanel>
  </StackPanel></Border>
 </StackPanel>
</UserControl>
