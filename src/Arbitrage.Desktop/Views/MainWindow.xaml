<Window x:Class="Arbitrage.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Arbitrage.Desktop.ViewModels"
        xmlns:views="clr-namespace:Arbitrage.Desktop.Views"
        xmlns:controls="clr-namespace:Arbitrage.Desktop.Controls"
        Title="Arbitrage Trading" Icon="/Arbitrage.Desktop;component/Assets/ArbitrageTrading.ico"
        Width="1240" Height="790" MinWidth="830" MinHeight="590"
        Background="{DynamicResource ApplicationBackground}" Foreground="{DynamicResource PrimaryText}"
        FontFamily="Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <controls:StatusToneConverter x:Key="StatusTone" />
    <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><views:DashboardView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:DiagnosticsViewModel}"><views:DiagnosticsView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:TradingViewModel}"><views:TradingView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:StrategiesViewModel}"><views:StrategiesView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:PaperAnalyticsViewModel}"><views:PaperAnalyticsView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:PaperTradingPageViewModel}"><views:PaperTradingView DataContext="{Binding State}" /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:PaperPortfolioViewModel}"><views:PaperPortfolioView DataContext="{Binding State}" /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:PaperReliabilityViewModel}"><views:PaperReliabilityView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:MarketExplorerViewModel}"><views:MarketExplorerView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:OpportunitiesViewModel}"><views:OpportunitiesView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:RelationshipsViewModel}"><views:RelationshipsView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:UnavailablePageViewModel}"><views:UnavailablePageView /></DataTemplate>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Border Grid.RowSpan="3" Grid.Column="0" Background="{DynamicResource NavigationBackground}"
            BorderBrush="{DynamicResource DefaultBorder}" BorderThickness="0,0,1,0">
      <Grid Margin="12,16,12,12">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Margin="8,4,8,16">
          <DockPanel>
            <Image Source="{StaticResource AppMark}" Width="38" Height="38" Margin="0,0,10,0" AutomationProperties.Name="Arbitrage Trading mark"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Arbitrage" FontSize="18" FontWeight="SemiBold"/>
              <TextBlock Text="TRADING" Style="{StaticResource EyebrowText}" Foreground="{DynamicResource Accent}"/>
            </StackPanel>
          </DockPanel>
          <TextBlock Text="Local workstation" Style="{StaticResource MutedText}" Margin="0,14,0,0" />
        </StackPanel>
        <ListBox Grid.Row="1" ItemsSource="{Binding Navigation}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                 ItemContainerStyle="{StaticResource SidebarItem}" BorderThickness="0" Background="Transparent"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Application navigation">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <DockPanel LastChildFill="True" MinHeight="24">
                <Path DockPanel.Dock="Left" Data="{Binding Icon}" Width="16" Height="16" Stretch="Uniform"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" StrokeThickness="1.8" Margin="0,0,12,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Label}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                           VerticalAlignment="Center" />
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <Border Grid.Row="2" Style="{StaticResource InsetPanel}" Margin="2,12,2,0" Padding="12">
          <StackPanel>
            <TextBlock Text="LOCAL MODE" Foreground="{DynamicResource SecondaryText}" FontWeight="SemiBold" FontSize="11" />
            <TextBlock Text="{Binding State.LocalModeSummary}" Style="{StaticResource MutedText}" Margin="0,5,0,0" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource SurfaceBackground}"
            BorderBrush="{DynamicResource DefaultBorder}" BorderThickness="0,0,0,1" Padding="24,14,24,12">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel>
          <TextBlock Text="ARBITRAGE TRADING" Style="{StaticResource EyebrowText}" Foreground="{DynamicResource Accent}" />
          <TextBlock Text="{Binding PageTitle}" FontSize="24" FontWeight="SemiBold" Margin="0,3,0,4" />
          <TextBlock Text="{Binding State.WorkspaceHeader}" Style="{StaticResource MutedText}"
                     TextTrimming="CharacterEllipsis" MaxWidth="400" HorizontalAlignment="Left" />
        </StackPanel>
          <WrapPanel Grid.Row="1" Margin="0,10,12,0" VerticalAlignment="Center">
            <controls:StatusBadge Label="Local" Tone="Info" Margin="0,0,7,5" />
            <controls:StatusBadge Label="{Binding LocalBackend.ProcessStatus, TargetNullValue=Unknown, FallbackValue=Unknown}" Tone="{Binding LocalBackend.ProcessStatus, Converter={StaticResource StatusTone}}" Margin="0,0,7,5" />
            <controls:StatusBadge Label="{Binding State.ConnectionStatus}" Tone="{Binding State.ConnectionStatus, Converter={StaticResource StatusTone}}" Margin="0,0,7,5" />
            <controls:StatusBadge Label="{Binding State.TradingMode}" Tone="{Binding State.TradingMode, Converter={StaticResource StatusTone}}" Margin="0,0,7,5" />
            <controls:StatusBadge Label="{Binding State.PaperStatusLabel}" Tone="{Binding State.PaperStatusTone}" Margin="0,0,7,5" />
            <controls:StatusBadge Label="{Binding State.LiveStatusLabel}" Tone="{Binding State.LiveStatusTone}" Margin="0,0,0,5" />
          </WrapPanel>
        <controls:ThemePicker Grid.Column="1" DataContext="{Binding Theme}" HorizontalAlignment="Right" VerticalAlignment="Top" />
        <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,8,0,0">
          <TextBlock Text="LOCAL BACKEND" Foreground="{DynamicResource SecondaryText}" FontWeight="SemiBold"
                     FontSize="11" HorizontalAlignment="Right" Margin="0,0,0,6" />
          <StackPanel Orientation="Horizontal">
            <Button Style="{StaticResource SuccessButton}" Content="Start" Command="{Binding LocalBackend.StartCommand}" IsEnabled="{Binding LocalBackend.CanStart}"
                    ToolTip="{Binding LocalBackend.StartExplanation}" AutomationProperties.Name="Start local backend" Margin="0,0,6,0" />
            <Button Style="{StaticResource DangerButton}" Content="Stop" Command="{Binding LocalBackend.StopCommand}" IsEnabled="{Binding LocalBackend.CanStop}"
                    ToolTip="{Binding LocalBackend.StopExplanation}" AutomationProperties.Name="Stop local backend" Margin="0,0,6,0" />
            <Button Style="{StaticResource PrimaryButton}" Content="Refresh" Command="{Binding State.RefreshCommand}" IsEnabled="{Binding LocalBackend.CanRefresh}" AutomationProperties.Name="Refresh backend state" />
          </StackPanel>
        </StackPanel>
        <Border Grid.Row="2" Grid.ColumnSpan="2" Margin="0,10,0,0">
          <Border.Style><Style TargetType="Border" BasedOn="{StaticResource StatusBanner}"><Style.Triggers><DataTrigger Binding="{Binding LocalBackend.Explanation, FallbackValue={x:Null}}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding LocalBackend.Explanation}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
          <Border.Tag><MultiBinding Converter="{StaticResource StatusTone}"><Binding Path="LocalBackend.ProcessStatus" /><Binding Path="LocalBackend.ManagementStatus" /><Binding Path="LocalBackend.Explanation" /><Binding Path="State.ConnectionStatus" /></MultiBinding></Border.Tag>
          <TextBlock Text="{Binding LocalBackend.Explanation}" Foreground="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource AncestorType=Border}}" TextWrapping="Wrap" AutomationProperties.AutomationId="BackendActionResult" />
        </Border>
      </Grid>
    </Border>
    <ContentControl Grid.Row="1" Grid.Column="1" Content="{Binding CurrentPage}" Margin="24,20,24,10" />
    <Border Grid.Row="2" Grid.Column="1" Background="{DynamicResource SurfaceBackground}"
            BorderBrush="{DynamicResource DefaultBorder}" BorderThickness="0,1,0,0" Padding="24,9">
      <DockPanel LastChildFill="True">
        <TextBlock DockPanel.Dock="Right" Text="{Binding State.DataAge}" Style="{StaticResource MutedText}" />
        <TextBlock DockPanel.Dock="Right" Text="  ·  " Style="{StaticResource MutedText}" />
        <TextBlock DockPanel.Dock="Left" Text="{Binding State.ConnectionStatus}" FontWeight="SemiBold" />
        <TextBlock DockPanel.Dock="Left" Text="{Binding LocalBackend.ManagementStatus}" Margin="10,0,0,0" Style="{StaticResource MutedText}" />
        <TextBlock Text="{Binding State.Message}" Foreground="{DynamicResource SecondaryText}" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>
  </Grid>
</Window>
