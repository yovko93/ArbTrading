<UserControl x:Class="Arbitrage.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Arbitrage.Desktop.Controls">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Resources/Styles/MarketWorkflow.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <!-- Availability is contextual: only Paper receives success emphasis. Live labels remain literal and neutral. -->
      <Style x:Key="SettingsCapability" TargetType="controls:StatusBadge" BasedOn="{StaticResource WorkflowState}">
        <Style.Triggers>
          <Trigger Property="Label" Value="Available"><Setter Property="Tone" Value="Neutral" /></Trigger>
          <Trigger Property="Label" Value="Unknown"><Setter Property="Tone" Value="Warning" /></Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="SettingsPaperCapability" TargetType="controls:StatusBadge" BasedOn="{StaticResource SettingsCapability}">
        <Style.Triggers>
          <Trigger Property="Label" Value="Available"><Setter Property="Tone" Value="Good" /></Trigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel MaxWidth="1120" HorizontalAlignment="Stretch">
      <controls:SectionHeader Title="Settings" Subtitle="Appearance stays on this Windows user profile. Workspace changes go through the authorized backend API." />
      <Border Style="{StaticResource WorkflowCard}" AutomationProperties.AutomationId="SettingsAppearance">
        <StackPanel>
          <TextBlock Text="DESKTOP PREFERENCES" Style="{StaticResource EyebrowText}" />
          <TextBlock Text="Appearance" Style="{StaticResource SectionTitleText}" Margin="0,3,0,10" />
          <WrapPanel>
            <StackPanel Style="{StaticResource WorkflowField}">
              <TextBlock Text="Dark, Light, or System (Windows applications theme)" Style="{StaticResource FieldLabel}" Margin="0,0,0,5" />
              <controls:ThemePicker DataContext="{Binding Theme}" HorizontalAlignment="Left" />
            </StackPanel>
            <Border Style="{StaticResource WorkflowMetric}" Margin="0,0,0,8">
              <StackPanel>
                <TextBlock Text="Effective appearance" Style="{StaticResource EyebrowText}" />
                <TextBlock Text="{Binding Theme.EffectiveAppearance}" Style="{StaticResource CardHeadingText}" Margin="0,4,0,0" />
              </StackPanel>
            </Border>
          </WrapPanel>
          <TextBlock Text="This preference is stored only for this desktop user." Style="{StaticResource MutedText}" />
          <Border Style="{StaticResource WorkflowNotice}" ToolTip="{Binding Theme.SaveNotice}" Tag="Warning" Margin="0,8,0,0">
            <TextBlock Text="{Binding Theme.SaveNotice}" Foreground="{DynamicResource Warning}" AutomationProperties.LiveSetting="Polite" />
          </Border>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource StatusBanner}" Tag="Warning" Margin="0,0,0,12"
              AutomationProperties.AutomationId="SettingsAccessDenied"
              Visibility="{Binding State.IsWorkspaceAccessDenied, Converter={StaticResource BooleanToVisibility}}">
        <StackPanel>
          <TextBlock Text="Workspace access unavailable" Style="{StaticResource CardHeadingText}" Margin="0,0,0,4" />
          <TextBlock Text="Workspace editing is hidden until local authentication and authorization succeed. Unsaved input is retained for this session."
                     Foreground="{DynamicResource Warning}" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource WorkflowCard}" AutomationProperties.AutomationId="SettingsWorkspace"
              Visibility="{Binding State.IsWorkspaceAuthorized, Converter={StaticResource BooleanToVisibility}}">
        <StackPanel>
          <TextBlock Text="AUTHORIZED WORKSPACE" Style="{StaticResource EyebrowText}" />
          <TextBlock Text="Workspace" Style="{StaticResource SectionTitleText}" Margin="0,3,0,10" />
          <TextBlock Text="Display name" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
          <TextBox Text="{Binding State.WorkspaceName, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding State.CanEdit}"
                   MaxLength="100" HorizontalAlignment="Stretch" AutomationProperties.Name="Workspace display name" />
          <Border Style="{StaticResource WorkflowNotice}" ToolTip="{Binding State.ValidationMessage}" Tag="Error" Margin="0,8,0,0">
            <TextBlock Text="{Binding State.ValidationMessage}" Foreground="{DynamicResource Error}" AutomationProperties.LiveSetting="Polite" />
          </Border>
          <Border Style="{StaticResource WorkflowNotice}" ToolTip="{Binding State.ServerChangeNotice}" Tag="Warning" Margin="0,8,0,0">
            <TextBlock Text="{Binding State.ServerChangeNotice}" Foreground="{DynamicResource Warning}"
                       TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
          </Border>
          <Button Content="Save workspace name" Command="{Binding State.SaveCommand}" IsEnabled="{Binding State.CanSave}"
                  Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,10,0,0" AutomationProperties.Name="Save workspace display name" />
          <Border Style="{StaticResource WorkflowNotice}" ToolTip="{Binding State.WorkspaceFeedback}" Margin="0,8,0,0">
            <TextBlock Text="{Binding State.WorkspaceFeedback}" AutomationProperties.LiveSetting="Polite" />
          </Border>
          <TextBlock Text="Backend authorization and audit remain authoritative." Style="{StaticResource MutedText}" Margin="0,8,0,0" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource WorkflowCard}" AutomationProperties.AutomationId="SettingsFeeProfile"
              Visibility="{Binding State.IsWorkspaceAuthorized, Converter={StaticResource BooleanToVisibility}}">
        <StackPanel DataContext="{Binding Fees}">
          <TextBlock Text="DIAGNOSTIC ASSUMPTION" Style="{StaticResource EyebrowText}" />
          <TextBlock Text="Fee calculation profile (diagnostic assumption)" Style="{StaticResource SectionTitleText}" Margin="0,3,0,8" />
          <TextBlock Text="Controls local Kalshi fee calculations only. Does not authenticate or identify your Kalshi account. Default: Unknown." TextWrapping="Wrap" Style="{StaticResource MutedText}" />
          <TextBlock Text="Unknown remains distinct from zero." Style="{StaticResource MutedText}" Margin="0,4,0,10" />
          <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding Profile}" Width="210" HorizontalAlignment="Left" AutomationProperties.Name="Fee calculation profile (diagnostic assumption)" />
          <WrapPanel Margin="0,10,0,2">
            <Button Content="Load saved assumption" Command="{Binding LoadCommand}" Margin="0,0,8,8" />
            <Button Content="Save diagnostic assumption" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,0,8" />
          </WrapPanel>
          <Border Style="{StaticResource WorkflowNotice}" ToolTip="{Binding Notice}" Margin="0">
            <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
          </Border>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource WorkflowCard}" AutomationProperties.AutomationId="SettingsCredentials"
              Visibility="{Binding State.IsWorkspaceAuthorized, Converter={StaticResource BooleanToVisibility}}">
        <StackPanel DataContext="{Binding Credentials}">
          <TextBlock Text="PROTECTED LOCAL CREDENTIALS" Style="{StaticResource EyebrowText}" />
          <TextBlock Text="Kalshi Realtime Market Data" Style="{StaticResource SectionTitleText}" Margin="0,3,0,8" />
          <TextBlock Text="Private keys stay in protected backend storage for this Windows user. Import leaves your original key file unchanged." Style="{StaticResource MutedText}" TextWrapping="Wrap" />
          <TextBlock Text="API Key ID" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
          <TextBox Text="{Binding KeyId, UpdateSourceTrigger=PropertyChanged}" MaxLength="128" HorizontalAlignment="Stretch" AutomationProperties.Name="Kalshi API key ID" />
          <WrapPanel Margin="0,10,0,2">
            <Button Content="Select Private Key File" Command="{Binding SelectPrivateKeyFileCommand}" Margin="0,0,8,8" />
            <Button Content="Import / Replace" Command="{Binding ImportCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" />
            <Button Content="Remove" Command="{Binding RemoveCommand}" Style="{StaticResource DangerButton}" Margin="0,0,8,8" />
            <Button Content="Refresh status" Command="{Binding RefreshStatusCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,0,8" />
          </WrapPanel>
          <TextBlock Text="{Binding SelectedFile}" TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,0,0,8" />
          <Border Style="{StaticResource WorkflowNotice}" ToolTip="{Binding Notice}">
            <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
          </Border>
          <Border Style="{StaticResource InsetPanel}" Padding="12" Margin="0">
            <StackPanel>
              <TextBlock Text="Credential status" Style="{StaticResource CardHeadingText}" Margin="0,0,0,8" />
              <TextBlock Text="{Binding Status.StoreCapability, StringFormat=Storage: {0}, TargetNullValue='Storage: Unavailable', FallbackValue='Storage: Unavailable'}" />
              <TextBlock Text="{Binding Status.MaskedKeyId, StringFormat=Key: {0}, TargetNullValue='Key: Unavailable', FallbackValue='Key: Unavailable'}" Margin="0,5,0,0" />
              <TextBlock Text="{Binding Status.PublicKeyFingerprint, StringFormat=Public fingerprint: {0}, TargetNullValue='Public fingerprint: Unavailable', FallbackValue='Public fingerprint: Unavailable'}" TextWrapping="Wrap" Margin="0,5,0,0" />
              <TextBlock Text="{Binding Status.LastAuthenticationResult, StringFormat=Last authentication: {0}, TargetNullValue='Last authentication: Unavailable', FallbackValue='Last authentication: Unavailable'}" Margin="0,5,0,0" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource WorkflowCard}" AutomationProperties.AutomationId="SettingsConnection">
        <StackPanel>
          <TextBlock Text="LOCAL BACKEND" Style="{StaticResource EyebrowText}" />
          <TextBlock Text="Connection" Style="{StaticResource SectionTitleText}" Margin="0,3,0,10" />
          <TextBlock Text="Local endpoint" Style="{StaticResource FieldLabel}" Margin="0,0,0,3" />
          <TextBlock Text="{Binding State.Endpoint}" TextWrapping="Wrap" />
          <WrapPanel Margin="0,12,0,0">
            <Border Style="{StaticResource WorkflowMetric}" Width="220"><StackPanel>
              <TextBlock Text="CONNECTION" Style="{StaticResource EyebrowText}" />
              <TextBlock Text="{Binding State.ConnectionStatus}" Style="{StaticResource CardHeadingText}" Margin="0,5,0,0" />
            </StackPanel></Border>
            <Border Style="{StaticResource WorkflowMetric}" Width="220"><StackPanel>
              <TextBlock Text="PROCESS" Style="{StaticResource EyebrowText}" />
              <TextBlock Text="{Binding LocalBackend.ProcessStatus}" Style="{StaticResource CardHeadingText}" Margin="0,5,0,0" />
            </StackPanel></Border>
            <Border Style="{StaticResource WorkflowMetric}" Width="220"><StackPanel>
              <TextBlock Text="MANAGEMENT" Style="{StaticResource EyebrowText}" />
              <TextBlock Text="{Binding LocalBackend.ManagementStatus}" Style="{StaticResource MutedText}" Margin="0,5,0,0" />
            </StackPanel></Border>
          </WrapPanel>
          <TextBlock Text="{Binding LocalBackend.Explanation}" Style="{StaticResource MutedText}" Margin="0,2,0,0" TextWrapping="Wrap" />
          <TextBlock Text="{Binding LocalBackend.StartExplanation}" Style="{StaticResource MutedText}" Margin="0,4,0,0" TextWrapping="Wrap" />
          <TextBlock Text="{Binding LocalBackend.StopExplanation}" Style="{StaticResource MutedText}" Margin="0,4,0,0" TextWrapping="Wrap" />
          <Border Style="{StaticResource InsetPanel}" Padding="12,9" Margin="0,10,0,0">
            <StackPanel>
              <TextBlock Text="{Binding State.TransportStatus}" Style="{StaticResource MutedText}" />
              <TextBlock Text="{Binding State.HeartbeatStatus}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
            </StackPanel>
          </Border>
          <Button Content="Refresh backend state" Command="{Binding State.RefreshCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,10,0,0" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource WorkflowCard}" AutomationProperties.AutomationId="SettingsApplication">
        <StackPanel>
          <TextBlock Text="DISTRIBUTION &amp; CAPABILITIES" Style="{StaticResource EyebrowText}" />
          <TextBlock Text="Application" Style="{StaticResource SectionTitleText}" Margin="0,3,0,10" />
          <Border Style="{StaticResource InsetPanel}" Padding="12" Margin="0,0,0,12" AutomationProperties.AutomationId="ProductInformation">
            <StackPanel>
              <DockPanel Margin="0,0,0,12">
                <Image Source="{StaticResource AppMark}" Width="32" Height="32" Margin="0,0,10,0" AutomationProperties.Name="Arbitrage Trading product mark" />
                <TextBlock Text="{Binding Product.Name}" Style="{StaticResource SectionTitleText}" VerticalAlignment="Center" />
              </DockPanel>
              <WrapPanel>
                <StackPanel Style="{StaticResource WorkflowField}" MinWidth="190">
                  <TextBlock Text="Application version (assembly)" Style="{StaticResource FieldLabel}" />
                  <TextBlock Text="{Binding Product.ApplicationVersion}" AutomationProperties.AutomationId="ProductVersion" />
                </StackPanel>
                <StackPanel Style="{StaticResource WorkflowField}" MinWidth="190">
                  <TextBlock Text="Runtime / architecture" Style="{StaticResource FieldLabel}" />
                  <TextBlock Text="{Binding Product.Runtime}" AutomationProperties.AutomationId="ProductRuntime" />
                </StackPanel>
              </WrapPanel>
              <TextBlock Text="Build identity (informational version)" Style="{StaticResource FieldLabel}" Margin="0,2,0,3" />
              <TextBlock Text="{Binding Product.BuildIdentity}" ToolTip="{Binding Product.BuildIdentity}" Style="{StaticResource IdentifierText}" AutomationProperties.AutomationId="ProductBuildIdentity" />
              <TextBlock Text="Source commit" Style="{StaticResource FieldLabel}" Margin="0,8,0,3" />
              <TextBlock Text="{Binding Product.SourceCommit}" ToolTip="{Binding Product.SourceCommit}" Style="{StaticResource IdentifierText}" AutomationProperties.AutomationId="ProductSourceCommit" />
              <TextBlock Text="Local paper workstation · live orders are not implemented. Package and signing evidence is shown below." Style="{StaticResource MutedText}" Margin="0,10,0,0" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource InsetPanel}" Padding="12" Margin="0,0,0,12" AutomationProperties.AutomationId="SettingsDistribution">
            <StackPanel>
              <TextBlock Text="Distribution and runtime" Style="{StaticResource CardHeadingText}" Margin="0,0,0,7" />
              <TextBlock Text="{Binding LocalBackend.DistributionSummary, TargetNullValue='Distribution information unavailable.', FallbackValue='Distribution information unavailable.'}" TextWrapping="Wrap" Style="{StaticResource MutedText}" />
            </StackPanel>
          </Border>
          <WrapPanel>
            <Border Style="{StaticResource WorkflowMetric}" Width="220"><StackPanel>
              <TextBlock Text="Backend version" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
              <TextBlock Text="{Binding State.BackendVersion}" Style="{StaticResource CardHeadingText}" />
            </StackPanel></Border>
            <Border Style="{StaticResource WorkflowMetric}" Width="220"><StackPanel>
              <TextBlock Text="Deployment: Local" Style="{StaticResource CardHeadingText}" />
              <TextBlock Text="Effective environment" Style="{StaticResource FieldLabel}" Margin="0,6,0,3" />
              <TextBlock Text="{Binding State.TradingMode}" />
            </StackPanel></Border>
          </WrapPanel>
          <Border Style="{StaticResource WorkflowNotice}" ToolTip="{Binding State.DataAge}" Margin="0,2,0,12">
            <TextBlock Text="{Binding State.DataAge}" Style="{StaticResource MutedText}" />
          </Border>
          <TextBlock Text="Execution capabilities" Style="{StaticResource CardHeadingText}" Margin="0,0,0,8" />
          <WrapPanel AutomationProperties.AutomationId="SettingsCapabilities">
            <Border Style="{StaticResource WorkflowMetric}" Width="214"><StackPanel>
              <TextBlock Text="Paper execution" Style="{StaticResource FieldLabel}" Margin="0,0,0,7" />
              <controls:StatusBadge Label="{Binding State.PaperExecutionLabel}" Style="{StaticResource SettingsPaperCapability}" AutomationProperties.AutomationId="SettingsPaperCapability" />
            </StackPanel></Border>
            <Border Style="{StaticResource WorkflowMetric}" Width="214"><StackPanel>
              <TextBlock Text="Live order submission" Style="{StaticResource FieldLabel}" Margin="0,0,0,7" />
              <controls:StatusBadge Label="{Binding State.LiveExecutionLabel}" Style="{StaticResource SettingsCapability}" AutomationProperties.AutomationId="SettingsLiveCapability" />
            </StackPanel></Border>
            <Border Style="{StaticResource WorkflowMetric}" Width="214"><StackPanel>
              <TextBlock Text="Manual live execution" Style="{StaticResource FieldLabel}" Margin="0,0,0,7" />
              <controls:StatusBadge Label="{Binding State.ManualExecutionLabel}" Style="{StaticResource SettingsCapability}" AutomationProperties.AutomationId="SettingsManualLiveCapability" />
            </StackPanel></Border>
            <Border Style="{StaticResource WorkflowMetric}" Width="214"><StackPanel>
              <TextBlock Text="Automatic live execution" Style="{StaticResource FieldLabel}" Margin="0,0,0,7" />
              <controls:StatusBadge Label="{Binding State.AutomaticExecutionLabel}" Style="{StaticResource SettingsCapability}" AutomationProperties.AutomationId="SettingsAutomaticLiveCapability" />
            </StackPanel></Border>
          </WrapPanel>
          <TextBlock Text="Automatic Paper is an explicitly armed Paper-mode simulation controlled from Trading. It is separate from Automatic live execution."
                     Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
