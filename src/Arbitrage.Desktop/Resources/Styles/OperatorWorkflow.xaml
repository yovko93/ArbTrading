<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Arbitrage.Desktop.Controls">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Arbitrage.Desktop;component/Resources/Styles/MarketWorkflow.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <!-- Opt-in operator presentation; no changes to unrelated pages or global palettes. -->
  <controls:OperatorToneConverter x:Key="OperatorTone" />
  <controls:OperatorTextConverter x:Key="OperatorText" />
  <controls:OperatorTimeConverter x:Key="OperatorTime" />
  <Style x:Key="OperatorState" TargetType="controls:StatusBadge">
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Tone" Value="{Binding Label, RelativeSource={RelativeSource Self}, Converter={StaticResource OperatorTone}}" />
  </Style>
  <Style x:Key="OperatorPanel" TargetType="Border" BasedOn="{StaticResource WorkflowCard}">
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    <Setter Property="BorderThickness" Value="3,1,1,1" />
  </Style>
  <Style x:Key="OperatorEmptyText" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
    <Setter Property="Visibility" Value="Collapsed" />
    <Setter Property="Margin" Value="0,8" />
    <Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
  </Style>
</ResourceDictionary>
