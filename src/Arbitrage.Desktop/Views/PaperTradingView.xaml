<UserControl x:Class="Arbitrage.Desktop.Views.PaperTradingView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Arbitrage.Desktop.Views" xmlns:controls="clr-namespace:Arbitrage.Desktop.Controls">
 <UserControl.Resources>
  <controls:StatusToneConverter x:Key="StatusTone" />
  <controls:PaperBalanceConverter x:Key="PaperBalance" />
  <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}"><Setter Property="RowHeight" Value="30"/><Setter Property="ColumnHeaderHeight" Value="32"/><Setter Property="GridLinesVisibility" Value="None"/><Setter Property="HeadersVisibility" Value="Column"/></Style>
  <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="Padding" Value="8,4"/></Style>
 </UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto">
  <StackPanel MaxWidth="1120" HorizontalAlignment="Stretch">
   <TextBlock Text="Paper Trading · SIMULATION ONLY" Style="{StaticResource MetricText}"/>
   <TextBlock Text="Mode: Paper. No real orders submitted. Explicit snapshot entries. Review holdings and settlement in Portfolio." TextWrapping="Wrap" Margin="0,8"/>
   <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" Margin="0,8" AutomationProperties.LiveSetting="Polite"/>
   <Border Style="{StaticResource CardBorder}"><StackPanel>
    <TextBlock Text="01 / Paper capital and generation" Style="{StaticResource SectionTitleText}" Margin="0,0,0,12"/>
    <Border Background="{DynamicResource ElevatedSurfaceBackground}" CornerRadius="5" Padding="14" Margin="0,0,0,12">
     <StackPanel>
      <DockPanel><TextBlock Text="Active generation" FontWeight="SemiBold"/>
       <controls:StatusBadge HorizontalAlignment="Right" Label="{Binding Account.Generation.Integrity, TargetNullValue=Unavailable, FallbackValue=Unavailable}" Tone="{Binding Account.Generation.Integrity, Converter={StaticResource StatusTone}}"/>
      </DockPanel>
      <TextBlock Text="{Binding AccountText}" Margin="0,6,0,0">
       <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Account.Generation}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
      </TextBlock>
      <TextBlock Text="{Binding Account.Generation.Id, StringFormat='Generation ID: {0}', TargetNullValue=No active generation, FallbackValue=No active generation}" Style="{StaticResource MutedText}" Margin="0,6,0,0"/>
      <WrapPanel Margin="0,6,0,0"><TextBlock Text="{Binding Account.State, StringFormat='State: {0}'}" Margin="0,0,18,0"/><TextBlock Text="{Binding Account.Generation.CreatedAt, StringFormat='Created at: {0:O}', TargetNullValue=Created at: unavailable, FallbackValue=Created at: unavailable}" Style="{StaticResource MutedText}"/></WrapPanel>
     </StackPanel>
    </Border>
    <UniformGrid Columns="2" Margin="0,0,0,16" AutomationProperties.Name="Execution funding available">
     <Border Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource SemanticBrush.InfoBorder}" BorderThickness="1" CornerRadius="5" Padding="14" Margin="0,0,6,0">
      <StackPanel DataContext="{Binding Account.Balances, Converter={StaticResource PaperBalance}, ConverterParameter=Kalshi/USD}">
       <TextBlock Text="Kalshi / USD" FontWeight="SemiBold"/>
       <TextBlock Text="Available for entry" Style="{StaticResource MutedText}" Margin="0,7,0,3"/>
       <TextBlock Text="{Binding AvailableCash, TargetNullValue=Unavailable, FallbackValue=Unavailable}" Style="{StaticResource MetricText}"/>
       <TextBlock Text="USD · simulated funds" Style="{StaticResource MutedText}" FontSize="11" Margin="0,3,0,0"/>
      </StackPanel>
     </Border>
     <Border Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource SemanticBrush.InfoBorder}" BorderThickness="1" CornerRadius="5" Padding="14" Margin="6,0,0,0">
      <StackPanel DataContext="{Binding Account.Balances, Converter={StaticResource PaperBalance}, ConverterParameter=Polymarket/USDC}">
       <TextBlock Text="Polymarket / USDC" FontWeight="SemiBold"/>
       <TextBlock Text="Available for entry" Style="{StaticResource MutedText}" Margin="0,7,0,3"/>
       <TextBlock Text="{Binding AvailableCash, TargetNullValue=Unavailable, FallbackValue=Unavailable}" Style="{StaticResource MetricText}"/>
       <TextBlock Text="USDC · simulated funds" Style="{StaticResource MutedText}" FontSize="11" Margin="0,3,0,0"/>
      </StackPanel>
     </Border>
    </UniformGrid>
    <Border BorderBrush="{DynamicResource DefaultBorder}" BorderThickness="0,1,0,0" Padding="0,14,0,0"><StackPanel>
    <TextBlock Text="Initialize / Reset paper generation" FontWeight="SemiBold"/>
    <TextBlock Text="Review initial amounts and reason before confirming a generation change." Style="{StaticResource MutedText}" Margin="0,4,0,4"/>
    <WrapPanel Margin="0,8">
     <StackPanel Margin="0,0,12,8"><TextBlock Text="Initial Kalshi USD"/><TextBox Text="{Binding KalshiStartingCash, UpdateSourceTrigger=PropertyChanged}" Width="150" AutomationProperties.Name="Initial Kalshi USD"/></StackPanel>
     <StackPanel Margin="0,0,12,8"><TextBlock Text="Initial Polymarket USDC"/><TextBox Text="{Binding PolymarketStartingCash, UpdateSourceTrigger=PropertyChanged}" Width="150" AutomationProperties.Name="Initial Polymarket USDC"/></StackPanel>
     <StackPanel Margin="0,0,0,8"><TextBlock Text="Initialization / reset reason"/><TextBox Text="{Binding ResetReason, UpdateSourceTrigger=PropertyChanged}" Width="320" AutomationProperties.Name="Paper generation reason"/></StackPanel>
    </WrapPanel>
    <WrapPanel><Button Style="{StaticResource DangerButton}" Margin="0,0,8,6" Content="Initialize / Reset paper generation…" Command="{Binding InitializeCommand}"/><Button Style="{StaticResource PrimaryButton}" Content="Refresh paper account" Command="{Binding RefreshCommand}" Margin="0,0,0,6"/></WrapPanel>
    </StackPanel></Border>
   </StackPanel></Border>
   <views:PaperRiskView/>
   <views:PaperAutomationView/>
   <Border Style="{StaticResource CardBorder}"><StackPanel>
    <TextBlock Text="03 / Explicit snapshot preview" Style="{StaticResource SectionTitleText}" Margin="0,0,0,8"/>
    <TextBlock Text="Select Paper preview on a current opportunity. USD and USDC are separate; no conversion is assumed." TextWrapping="Wrap"/>
    <TextBlock Text="{Binding OpportunityKey}" TextWrapping="Wrap" Margin="0,8"/>
    <WrapPanel><TextBlock Text="Requested quantity" VerticalAlignment="Center"/><TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="120" Margin="8,0" AutomationProperties.Name="Paper requested quantity"/>
     <Button Style="{StaticResource SecondaryButton}" Margin="0,0,8,6" Content="Create paper preview" Command="{Binding PreviewCommand}"/><Button Style="{StaticResource PrimaryButton}" Content="Confirm paper execution…" Command="{Binding ExecuteCommand}" Margin="0,0,0,6"/></WrapPanel>
    <TextBlock Text="{Binding PreviewText}" TextWrapping="Wrap" Margin="0,10"/>
    <DataGrid ItemsSource="{Binding Preview.Fills}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MaxHeight="180" AutomationProperties.Name="Preview snapshot fills">
     <DataGrid.Columns><DataGridTextColumn Header="Venue" Binding="{Binding Exchange}" Width="120"/><DataGridTextColumn Header="Instrument" Binding="{Binding InstrumentId}" Width="150"/><DataGridTextColumn Header="Outcome" Binding="{Binding Outcome}" Width="110"/><DataGridTextColumn Header="BUY quantity" Binding="{Binding Quantity}" Width="110"/><DataGridTextColumn Header="Price" Binding="{Binding Price}" Width="100"/><DataGridTextColumn Header="Modeled fee" Binding="{Binding Fee}" Width="120"/><DataGridTextColumn Header="Currency" Binding="{Binding Currency}" Width="90"/><DataGridTextColumn Header="Liquidity origin" Binding="{Binding LiquidityOrigin}" Width="180"/><DataGridTextColumn Header="Book version" Binding="{Binding BookVersion}" Width="120"/></DataGrid.Columns>
    </DataGrid>
   </StackPanel></Border>
  </StackPanel>
 </ScrollViewer>
</UserControl>
