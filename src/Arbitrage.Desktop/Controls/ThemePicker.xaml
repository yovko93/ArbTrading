<UserControl x:Class="Arbitrage.Desktop.Controls.ThemePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Preference, Mode=TwoWay}"
            AutomationProperties.Name="Appearance preference" ToolTip="Dark, Light, or follow the Windows apps theme" />
</UserControl>
