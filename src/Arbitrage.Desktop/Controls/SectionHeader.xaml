<UserControl x:Class="Arbitrage.Desktop.Controls.SectionHeader"
             x:Name="Root" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel Margin="0,0,0,14">
    <TextBlock Text="{Binding Title, ElementName=Root}" Style="{StaticResource PageTitleText}" />
    <TextBlock Text="{Binding Subtitle, ElementName=Root}" Style="{StaticResource MutedText}" Margin="0,5,0,0" />
  </StackPanel>
</UserControl>
