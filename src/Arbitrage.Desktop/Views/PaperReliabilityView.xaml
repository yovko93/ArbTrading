<UserControl x:Class="Arbitrage.Desktop.Views.PaperReliabilityView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:Arbitrage.Desktop.Controls"
 Background="{DynamicResource ApplicationBackground}" Foreground="{DynamicResource PrimaryText}">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Arbitrage.Desktop;component/Resources/Styles/OperatorWorkflow.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <Style x:Key="ReliabilityEmptyText" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
        <Setter Property="Margin" Value="0,10,0,4" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
      </Style>
    </ResourceDictionary>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="ReliabilityScroll">
    <StackPanel>
      <TextBlock Text="Paper reliability request in progress…" Style="{StaticResource BusyText}" Visibility="{Binding Busy, Converter={StaticResource BooleanToVisibility}}" AutomationProperties.LiveSetting="Polite" />
      <TextBlock Text="Paper Reliability Campaign" Style="{StaticResource PageTitleText}" Margin="0,0,0,6" />
      <TextBlock Text="Campaign observations, independent evidence criteria, and safety invariants." Style="{StaticResource PageSubtitleText}" Margin="0,0,0,12" />
      <Border Style="{StaticResource StatusBanner}" Tag="Warning" Margin="0,0,0,12">
        <TextBlock Text="PAPER SIMULATION EVIDENCE ONLY. CriteriaMet never enables live trading. No actual fills, exchange latency or real-capital profitability is demonstrated." TextWrapping="Wrap" />
      </Border>

      <Border Style="{StaticResource OperatorPanel}" AutomationProperties.AutomationId="ReliabilityCampaignSummary">
        <StackPanel>
          <TextBlock Text="{Binding Campaign.Name, TargetNullValue=No selected campaign, FallbackValue=No selected campaign}" Style="{StaticResource SectionTitleText}" Margin="0,0,0,10" />
          <WrapPanel Margin="0,0,0,8">
            <StackPanel Margin="0,0,24,8">
              <TextBlock Text="CAMPAIGN STATE" Style="{StaticResource EyebrowText}" Margin="0,0,0,4" />
              <controls:StatusBadge Label="{Binding Campaign.State, TargetNullValue=NoActiveCampaign, FallbackValue=NoActiveCampaign}" Style="{StaticResource OperatorState}" AutomationProperties.AutomationId="ReliabilityCampaignState" />
            </StackPanel>
            <StackPanel Margin="0,0,24,8">
              <TextBlock Text="PAPER EVIDENCE STATE" Style="{StaticResource EyebrowText}" Margin="0,0,0,4" />
              <controls:StatusBadge Label="{Binding Report.State, TargetNullValue=Unavailable, FallbackValue=Unavailable}" Style="{StaticResource OperatorState}" AutomationProperties.AutomationId="ReliabilityEvidenceState" />
            </StackPanel>
          </WrapPanel>
          <TextBlock Text="CriteriaMet unlocks no live execution capability." FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10" />
          <TextBlock Text="{Binding Campaign.StartedAt, Converter={StaticResource OperatorTime}, StringFormat=Started: {0}}" Style="{StaticResource MutedText}" />
          <TextBlock Text="{Binding Report.EvaluatedAt, Converter={StaticResource OperatorTime}, StringFormat=Persisted evaluation: {0}}" Style="{StaticResource MutedText}" />
          <TextBlock Text="{Binding Report.EvidenceGapDetected, StringFormat=Report evidence gap detected: {0}, TargetNullValue=Report evidence gap: Unknown, FallbackValue=Report evidence gap: Unknown}" Style="{StaticResource MutedText}" Margin="0,0,0,8" />
          <Expander Header="Campaign identity and policy diagnostics" Style="{StaticResource DetailsExpander}" Margin="0,6"><TextBlock Text="{Binding Summary}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" /></Expander>
          <TextBlock Text="{Binding Campaign.Id, StringFormat=Campaign ID: {0}, TargetNullValue=Campaign ID: Unavailable, FallbackValue=Campaign ID: Unavailable}" Style="{StaticResource MutedText}" Margin="0,8,0,0" />
          <Border Style="{StaticResource WorkflowNotice}" ToolTip="{Binding Notice}" Margin="0,10,0,0">
            <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" />
          </Border>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource WorkflowCard}" AutomationProperties.AutomationId="ReliabilityCampaignControls">
        <StackPanel>
          <TextBlock Text="Campaign controls" Style="{StaticResource SectionTitleText}" Margin="0,0,0,10" />
          <WrapPanel>
            <StackPanel Width="260" Style="{StaticResource WorkflowField}">
              <TextBlock Text="Campaign name" Margin="0,0,0,4" />
              <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" AutomationProperties.Name="Campaign name" />
            </StackPanel>
            <StackPanel Width="340" Style="{StaticResource WorkflowField}">
              <TextBlock Text="Notes" Margin="0,0,0,4" />
              <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" MaxLength="1000" AutomationProperties.Name="Campaign notes" />
            </StackPanel>
          </WrapPanel>
          <WrapPanel Margin="0,4,0,0">
            <Button Content="Start Reliability Campaign…" Command="{Binding ActionCommand}" CommandParameter="start" Style="{StaticResource SuccessButton}" Margin="0,0,8,8" />
            <Button Content="Pause…" Command="{Binding ActionCommand}" CommandParameter="pause" Style="{StaticResource WarningButton}" Margin="0,0,8,8" />
            <Button Content="Resume…" Command="{Binding ActionCommand}" CommandParameter="resume" Style="{StaticResource SuccessButton}" Margin="0,0,8,8" />
            <Button Content="Evaluate Now…" Command="{Binding ActionCommand}" CommandParameter="evaluate" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" />
            <Button Content="Complete…" Command="{Binding ActionCommand}" CommandParameter="complete" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" />
            <Button Content="Cancel…" Command="{Binding ActionCommand}" CommandParameter="cancel" Style="{StaticResource DangerButton}" Margin="0,0,8,8" />
            <Button Content="Export Report" Command="{Binding ExportCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" />
            <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" />
          </WrapPanel>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource WorkflowCard}" BorderBrush="{DynamicResource SemanticBrush.WarningBorder}" BorderThickness="3,1,1,1" AutomationProperties.AutomationId="ReliabilitySafetyInvariants">
        <StackPanel>
          <TextBlock Text="Safety invariants — Violated and Unknown are not Satisfied" Style="{StaticResource SectionTitleText}" Margin="0,0,0,6" />
          <TextBlock Text="Safety evidence is independent of ordinary campaign progress. Review each state and its explanation." Style="{StaticResource MutedText}" Margin="0,0,0,10" />
          <DataGrid x:Name="ReliabilityInvariants" ItemsSource="{Binding Report.Invariants}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" MaxHeight="300" RowHeight="NaN" MinRowHeight="40" AutomationProperties.Name="Safety invariants">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Invariant" Binding="{Binding Code}" Width="2*" MinWidth="120" ElementStyle="{StaticResource WorkflowWrappedCellText}" />
              <DataGridTemplateColumn Header="Status" Width="125">
                <DataGridTemplateColumn.CellTemplate><DataTemplate><controls:StatusBadge Label="{Binding State}" Style="{StaticResource OperatorState}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Evidence" Binding="{Binding ExplanationCode}" Width="2*" MinWidth="140" ElementStyle="{StaticResource WorkflowWrappedCellText}" />
            </DataGrid.Columns>
          </DataGrid>
          <TextBlock Text="Safety invariant evidence is unavailable. Unknown is not Satisfied." Style="{StaticResource ReliabilityEmptyText}" Tag="{Binding HasItems, ElementName=ReliabilityInvariants}" Foreground="{DynamicResource Warning}" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource OperatorPanel}" AutomationProperties.AutomationId="ReliabilityRemainingEvidence">
        <StackPanel>
          <TextBlock Text="Remaining evidence" Style="{StaticResource SectionTitleText}" Margin="0,0,0,8" />
          <TextBlock Text="{Binding RemainingEvidenceSummary}" Style="{StaticResource MutedText}" Margin="0,0,0,8" />
          <ItemsControl ItemsSource="{Binding RemainingEvidence}">
            <ItemsControl.ItemTemplate><DataTemplate>
              <Border Style="{StaticResource InsetPanel}" Margin="0,0,0,8">
                <StackPanel>
                  <TextBlock Text="{Binding Kind}" Style="{StaticResource EyebrowText}" />
                  <TextBlock Text="{Binding Code}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4" />
                  <WrapPanel>
                    <controls:StatusBadge Label="{Binding State}" Style="{StaticResource OperatorState}" Margin="0,0,12,6" />
                    <TextBlock Text="{Binding ObservedValue, StringFormat=Observed: {0}}" Margin="0,0,18,6" />
                    <TextBlock Text="{Binding RequiredValue, StringFormat=Required: {0}}" Margin="0,0,18,6" />
                  </WrapPanel>
                  <TextBlock Text="{Binding ExplanationCode}" Style="{StaticResource MutedText}" />
                </StackPanel>
              </Border>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource WorkflowCard}" AutomationProperties.AutomationId="ReliabilityRuntimeObservation">
        <StackPanel>
          <TextBlock Text="Runtime observation" Style="{StaticResource SectionTitleText}" Margin="0,0,0,8" />
          <TextBlock Text="{Binding Runtime}" TextWrapping="Wrap" />
          <TextBlock Text="Persisted campaign evidence; these durations do not establish live trading capability." Style="{StaticResource MutedText}" Margin="0,8,0,0" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource WorkflowCard}" AutomationProperties.AutomationId="ReliabilityEvidenceCriteria">
        <StackPanel>
          <TextBlock Text="Evidence criteria — each criterion is independent" Style="{StaticResource SectionTitleText}" Margin="0,0,0,10" />
          <DataGrid x:Name="ReliabilityCriteria" ItemsSource="{Binding Criteria}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" MaxHeight="300" RowHeight="NaN" MinRowHeight="40" AutomationProperties.Name="Evidence criteria">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Criterion" Binding="{Binding Code}" Width="2*" MinWidth="140" ElementStyle="{StaticResource WorkflowWrappedCellText}" />
              <DataGridTextColumn Header="Observed" Binding="{Binding ObservedValue}" Width="*" MinWidth="110" ElementStyle="{StaticResource WorkflowEconomics}" />
              <DataGridTextColumn Header="Required" Binding="{Binding RequiredValue}" Width="*" MinWidth="110" ElementStyle="{StaticResource WorkflowCellText}" />
              <DataGridTemplateColumn Header="Status" Width="150">
                <DataGridTemplateColumn.CellTemplate><DataTemplate><controls:StatusBadge Label="{Binding State}" Style="{StaticResource OperatorState}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Evidence" Binding="{Binding ExplanationCode}" Width="*" MinWidth="160" ElementStyle="{StaticResource WorkflowWrappedCellText}" />
            </DataGrid.Columns>
          </DataGrid>
          <TextBlock Text="No evidence criteria are available. Evaluate a selected campaign to obtain its persisted report." Style="{StaticResource ReliabilityEmptyText}" Tag="{Binding HasItems, ElementName=ReliabilityCriteria}" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource WorkflowCard}" AutomationProperties.AutomationId="ReliabilityOperationalFunnel">
        <StackPanel>
          <TextBlock Text="Operational funnel and sizing statistics" Style="{StaticResource SectionTitleText}" Margin="0,0,0,10" />
          <WrapPanel>
            <Border Style="{StaticResource WorkflowMetric}" Width="190"><StackPanel><TextBlock Text="CANDIDATE INPUTS" Style="{StaticResource EyebrowText}" /><TextBlock Text="{Binding Report.Counters[CandidateInputsObserved], TargetNullValue=Unavailable, FallbackValue=Unavailable}" Style="{StaticResource MetricText}" /></StackPanel></Border>
            <Border Style="{StaticResource WorkflowMetric}" Width="190"><StackPanel><TextBlock Text="DISTINCT TRIGGER INPUTS" Style="{StaticResource EyebrowText}" /><TextBlock Text="{Binding Report.Counters[DistinctTriggerInputs], TargetNullValue=Unavailable, FallbackValue=Unavailable}" Style="{StaticResource MetricText}" /></StackPanel></Border>
            <Border Style="{StaticResource WorkflowMetric}" Width="190"><StackPanel><TextBlock Text="SIZING ATTEMPTS" Style="{StaticResource EyebrowText}" /><TextBlock Text="{Binding Report.Counters[SizingAttempts], TargetNullValue=Unavailable, FallbackValue=Unavailable}" Style="{StaticResource MetricText}" /></StackPanel></Border>
            <Border Style="{StaticResource WorkflowMetric}" Width="190"><StackPanel><TextBlock Text="AUTO EXECUTIONS COMMITTED" Style="{StaticResource EyebrowText}" /><TextBlock Text="{Binding Report.Counters[AutomaticExecutionsCommitted], TargetNullValue=Unavailable, FallbackValue=Unavailable}" Style="{StaticResource MetricText}" /></StackPanel></Border>
            <Border Style="{StaticResource WorkflowMetric}" Width="190"><StackPanel><TextBlock Text="UNEXPECTED WORKER FAULTS" Style="{StaticResource EyebrowText}" /><TextBlock Text="{Binding Report.Counters[UnexpectedWorkerFaults], TargetNullValue=Unavailable, FallbackValue=Unavailable}" Style="{StaticResource MetricText}" /></StackPanel></Border>
          </WrapPanel>
          <Expander Header="All counters and sizing statistics" Style="{StaticResource DetailsExpander}" Margin="0,4,0,0">
            <StackPanel>
              <ItemsControl ItemsSource="{Binding Report.Counters}">
                <ItemsControl.ItemTemplate><DataTemplate>
                  <Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Key}" Margin="0,0,16,0" TextWrapping="Wrap" /><TextBlock Grid.Column="1" Text="{Binding Value}" FontWeight="SemiBold" />
                  </Grid>
                </DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
              <ItemsControl ItemsSource="{Binding Report.Statistics}">
                <ItemsControl.ItemTemplate><DataTemplate>
                  <Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Key}" Margin="0,0,16,0" TextWrapping="Wrap" /><TextBlock Grid.Column="1" Text="{Binding Value}" FontWeight="SemiBold" />
                  </Grid>
                </DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Expander>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource WorkflowCard}" AutomationProperties.AutomationId="ReliabilityPaperEconomics">
        <StackPanel>
          <TextBlock Text="Paper economics — separate from system reliability" Style="{StaticResource SectionTitleText}" Margin="0,0,0,10" />
          <DataGrid x:Name="ReliabilityEconomics" ItemsSource="{Binding Report.Economics}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" MaxHeight="240" MinColumnWidth="110" AutomationProperties.Name="Paper economics by generation venue currency">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Generation" Binding="{Binding GenerationId}" Width="250" />
              <DataGridTextColumn Header="Venue" Binding="{Binding Exchange}" />
              <DataGridTextColumn Header="Currency" Binding="{Binding Currency}" />
              <DataGridTextColumn Header="Entry cost" Binding="{Binding EntryCost}" ElementStyle="{StaticResource WorkflowEconomics}" />
              <DataGridTextColumn Header="Expected profit allocation" Width="200" Binding="{Binding ExpectedProfitAtEntry}" ElementStyle="{StaticResource WorkflowEconomics}" />
              <DataGridTextColumn Header="Settled payout" Binding="{Binding SettlementPayout}" ElementStyle="{StaticResource WorkflowEconomics}" />
              <DataGridTextColumn Header="Realized paper profit" Width="190" Binding="{Binding RealizedPaperProfit}" ElementStyle="{StaticResource WorkflowEconomics}" />
              <DataGridTextColumn Header="Open cost" Binding="{Binding UnsettledCostBasis}" ElementStyle="{StaticResource WorkflowEconomics}" />
            </DataGrid.Columns>
          </DataGrid>
          <TextBlock Text="No paper economics are available in the selected report." Style="{StaticResource ReliabilityEmptyText}" Tag="{Binding HasItems, ElementName=ReliabilityEconomics}" />
          <Border Style="{StaticResource StatusBanner}" Tag="Warning" Margin="0,10,0,0">
            <TextBlock Text="Basket expected payout is allocated equally to its two legs for venue reporting; this is not an expected venue outcome. ManualScenario resolution is not exchange performance. No USD/USDC aggregation." TextWrapping="Wrap" />
          </Border>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource WorkflowCard}" AutomationProperties.AutomationId="ReliabilityLimitations">
        <StackPanel>
          <TextBlock Text="Limitations and evidence gaps" Style="{StaticResource SectionTitleText}" Margin="0,0,0,8" />
          <TextBlock Text="{Binding Report.Disclaimer, TargetNullValue=No persisted report available., FallbackValue=No persisted report available.}" TextWrapping="Wrap" Margin="0,0,0,8" />
          <ItemsControl ItemsSource="{Binding Report.Limitations}">
            <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,6" /></DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{Binding Report.EvidenceFingerprint, StringFormat=Evidence fingerprint: {0}, TargetNullValue=Evidence fingerprint: Unavailable, FallbackValue=Evidence fingerprint: Unavailable}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource WorkflowCard}" AutomationProperties.AutomationId="ReliabilityCampaignHistory">
        <StackPanel>
          <TextBlock Text="Campaign history and reports" Style="{StaticResource SectionTitleText}" Margin="0,0,0,10" />
          <WrapPanel>
            <Button Content="Previous campaigns" Command="{Binding PreviousHistoryCommand}" Margin="0,0,8,8" />
            <Button Content="Next campaigns" Command="{Binding NextHistoryCommand}" Margin="0,0,8,8" />
            <Button Content="Read selected report" Command="{Binding ReadReportCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" />
          </WrapPanel>
          <DataGrid x:Name="ReliabilityHistory" ItemsSource="{Binding Campaigns}" SelectedItem="{Binding Campaign}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" MaxHeight="240" AutomationProperties.Name="Campaign history">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" MinWidth="180" />
              <DataGridTextColumn Header="State" Binding="{Binding State}" Width="130" />
              <DataGridTextColumn Header="Started UTC" Binding="{Binding StartedAt}" Width="220" />
            </DataGrid.Columns>
          </DataGrid>
          <TextBlock Text="No campaign history is available. Starting a campaign is an explicit action." Style="{StaticResource ReliabilityEmptyText}" Tag="{Binding HasItems, ElementName=ReliabilityHistory}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
