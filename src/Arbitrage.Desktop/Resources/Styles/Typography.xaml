<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Segoe UI" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="PageTitleText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="SectionTitleText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="MutedText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
  </Style>
  <Style x:Key="MetricText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="EyebrowText" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="LargeMetricText" TargetType="TextBlock" BasedOn="{StaticResource MetricText}">
    <Setter Property="FontSize" Value="28" />
  </Style>
  <Style x:Key="PageSubtitleText" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="LineHeight" Value="20" />
  </Style>
  <Style x:Key="CardHeadingText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="IdentifierText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontFamily" Value="Consolas" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="BusyText" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
    <Setter Property="Foreground" Value="{DynamicResource SemanticBrush.InfoForeground}" />
    <Setter Property="Margin" Value="0,0,0,10" />
  </Style>
</ResourceDictionary>
