<UserControl x:Class="Arbitrage.Desktop.Views.PaperAnalyticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Arbitrage.Desktop.Controls">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel MaxWidth="1160" HorizontalAlignment="Left">
      <controls:SectionHeader Title="Analytics" Subtitle="Read-only paper capital, performance, executable valuation, and reliability summary." />
      <Button Content="Refresh summary" Command="{Binding RefreshCommand}" Width="145" HorizontalAlignment="Left" Margin="0,0,0,10" AutomationProperties.Name="Refresh paper analytics summary" />
      <TextBlock Text="{Binding Notice}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10" />
      <Border Style="{StaticResource CardBorder}">
        <StackPanel>
          <TextBlock Text="Paper generation" Style="{StaticResource SectionTitleText}" />
          <TextBlock Text="{Binding GenerationSummary}" TextWrapping="Wrap" Margin="0,8,0,4" />
          <TextBlock Text="{Binding ExecutionSummary}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource CardBorder}">
        <StackPanel>
          <TextBlock Text="Capital and realized performance" Style="{StaticResource SectionTitleText}" />
          <TextBlock Text="Each row is one venue and currency. Monetary values are never combined across currencies." Style="{StaticResource MutedText}" Margin="0,6,0,8" />
          <DataGrid ItemsSource="{Binding Buckets}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MinHeight="90">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Venue" Binding="{Binding Exchange}" Width="120" />
              <DataGridTextColumn Header="Currency" Binding="{Binding Currency}" Width="90" />
              <DataGridTextColumn Header="Starting cash" Binding="{Binding StartingCash, StringFormat=N2}" Width="110" />
              <DataGridTextColumn Header="Current cash" Binding="{Binding CurrentCash, StringFormat=N2}" Width="110" />
              <DataGridTextColumn Header="Open cost" Binding="{Binding OpenCostBasis, StringFormat=N2}" Width="105" />
              <DataGridTextColumn Header="Realized P&amp;L" Binding="{Binding RealizedPnl, StringFormat=N2}" Width="110" />
              <DataGridTextColumn Header="Open positions" Binding="{Binding OpenPositions}" Width="100" />
              <DataGridTextColumn Header="Settled positions" Binding="{Binding SettledPositions}" Width="110" />
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource CardBorder}">
        <StackPanel>
          <TextBlock Text="Executable valuation" Style="{StaticResource SectionTitleText}" />
          <TextBlock Text="{Binding ValuationSummary}" TextWrapping="Wrap" Margin="0,6,0,8" />
          <DataGrid ItemsSource="{Binding Buckets}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MinHeight="90">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Venue" Binding="{Binding Exchange}" Width="120" />
              <DataGridTextColumn Header="Currency" Binding="{Binding Currency}" Width="85" />
              <DataGridTextColumn Header="Book value" Binding="{Binding AccountingBookValue, TargetNullValue=Unavailable, StringFormat=N2}" Width="100" />
              <DataGridTextColumn Header="Gross equity" Binding="{Binding GrossMarkedEquity, TargetNullValue=Unavailable, StringFormat=N2}" Width="100" />
              <DataGridTextColumn Header="Fee-adjusted equity" Binding="{Binding FeeAdjustedMarkedEquity, TargetNullValue=Unavailable, StringFormat=N2}" Width="125" />
              <DataGridTextColumn Header="Gross unrealized" Binding="{Binding GrossUnrealizedPnl, TargetNullValue=Unavailable, StringFormat=N2}" Width="115" />
              <DataGridTextColumn Header="Fee-adjusted unrealized" Binding="{Binding FeeAdjustedUnrealizedPnl, TargetNullValue=Unavailable, StringFormat=N2}" Width="145" />
              <DataGridTextColumn Header="Coverage" Binding="{Binding Coverage}" Width="180" />
            </DataGrid.Columns>
          </DataGrid>
          <TextBlock Text="Unrealized values are derived from API total P&amp;L minus realized P&amp;L only when full totals are available. See Portfolio for position-level marks and settlement." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource CardBorder}">
        <StackPanel>
          <TextBlock Text="Paper Reliability" Style="{StaticResource SectionTitleText}" />
          <TextBlock Text="{Binding ReliabilitySummary}" TextWrapping="Wrap" Margin="0,8,0,4" />
          <TextBlock Text="{Binding ReliabilityRuntime}" TextWrapping="Wrap" />
          <TextBlock Text="Open Paper Reliability for the full evidence report and campaign controls." Style="{StaticResource MutedText}" Margin="0,8,0,0" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
