<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:controls="clr-namespace:Arbitrage.Desktop.Controls" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Arbitrage.Desktop.Views.MonitoringView" Background="{DynamicResource ApplicationBackground}" Foreground="{DynamicResource PrimaryText}">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Arbitrage.Desktop;component/Resources/Styles/OperatorWorkflow.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="0">
      <TextBlock Text="Continuous opportunity monitoring" FontWeight="SemiBold" Style="{StaticResource PageTitleText}" Margin="0,0,0,6" />
      <TextBlock Text="READ-ONLY · Local cached inputs · No automatic subscriptions or fetches · Net profit unknown · Live execution unavailable; paper preview is explicit" Foreground="{DynamicResource Warning}" TextWrapping="Wrap" />
      <TextBlock Text="Backend-owned: closing this page or desktop does not stop monitoring. Restarting the backend leaves it Stopped." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,12" />
      <Border Style="{StaticResource OperatorPanel}">
        <StackPanel>
          <controls:StatusBadge Label="{Binding Status.State, TargetNullValue=Unavailable, FallbackValue=Unavailable}" Style="{StaticResource OperatorState}" Margin="0,0,0,8" />
          <TextBlock Text="{Binding Status.LastEvaluationAt, Converter={StaticResource OperatorTime}, StringFormat=Last backend evaluation: {0}}" Style="{StaticResource MutedText}" />
          <WrapPanel Margin="0,6,0,8">
            <TextBlock Text="{Binding Status.DirtyQueueDepth, StringFormat=Queue depth: {0}, TargetNullValue=Queue: Unavailable, FallbackValue=Queue: Unavailable}" Margin="0,0,18,4" />
            <TextBlock Text="{Binding Status.AlertsRaised, StringFormat=Alerts raised: {0}, TargetNullValue=Alerts: Unavailable, FallbackValue=Alerts: Unavailable}" Margin="0,0,18,4" />
          </WrapPanel>
          <TextBlock Text="Monitoring controls" Style="{StaticResource SectionTitleText}" Margin="0,0,0,10" />
          <WrapPanel Margin="0,8">
            <Button Content="Start Monitoring" Command="{Binding StartCommand}" Style="{StaticResource SuccessButton}" Margin="0,0,8,6" VerticalAlignment="Bottom" />
            <Button Content="Stop Monitoring" Command="{Binding StopCommand}" Margin="0,0,8,6" Style="{StaticResource DangerButton}" VerticalAlignment="Bottom" />
            <Button Content="Refresh display" Command="{Binding RefreshCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,6" VerticalAlignment="Bottom" />
          <Button Content="Save monitoring profile" Command="{Binding SaveProfileCommand}" HorizontalAlignment="Left" Margin="0,0,8,6" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" />
          </WrapPanel>
          <Border Style="{StaticResource WorkflowNotice}" ToolTip="{Binding Notice}">
            <TextBlock Text="{Binding Notice}" />
          </Border>
        </StackPanel>
      </Border>
      <WrapPanel AutomationProperties.AutomationId="MonitoringSummary" Margin="0,0,0,4">
        <Border Style="{StaticResource WorkflowMetric}" MinWidth="150">
          <StackPanel>
            <TextBlock Text="MONITORED" Style="{StaticResource EyebrowText}" />
            <TextBlock Text="{Binding Status.Coverage.RelationshipsMonitored, TargetNullValue=Unavailable, FallbackValue=Unavailable}" Style="{StaticResource MetricText}" />
            <TextBlock Text="{Binding Status.Coverage.ApprovedRelationshipsAvailable, StringFormat=Approved: {0}, TargetNullValue=Approved: Unavailable, FallbackValue=Unavailable}" Style="{StaticResource MutedText}" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource WorkflowMetric}" MinWidth="150">
          <StackPanel>
            <TextBlock Text="BOOKS AVAILABLE" Style="{StaticResource EyebrowText}" />
            <TextBlock Text="{Binding Status.Coverage.PlansWithBooksAvailable, TargetNullValue=Unavailable, FallbackValue=Unavailable}" Style="{StaticResource MetricText}" ToolTip="ORDERBOOKS" />
            <TextBlock Text="{Binding Status.Coverage.PlansWithActionableBooks, StringFormat=Actionable: {0}, TargetNullValue=Actionable: Unavailable, FallbackValue=Unavailable}" Style="{StaticResource MutedText}" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource WorkflowMetric}" MinWidth="150">
          <StackPanel>
            <TextBlock Text="FEE-ADJUSTED" Style="{StaticResource EyebrowText}" />
            <TextBlock Text="{Binding Status.Coverage.FeeAdjustedOpportunities, TargetNullValue=Unavailable, FallbackValue=Unavailable}" Style="{StaticResource MetricText}" ToolTip="OPPORTUNITIES" />
            <TextBlock Text="{Binding Status.Coverage.GrossOnlyOpportunities, StringFormat=Gross-only: {0}, TargetNullValue=Gross-only: Unavailable, FallbackValue=Unavailable}" Style="{StaticResource MutedText}" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource WorkflowMetric}" MinWidth="150">
          <StackPanel>
            <TextBlock Text="BLOCKED" Style="{StaticResource EyebrowText}" />
            <TextBlock Text="{Binding Status.Coverage.BlockedCandidates, TargetNullValue=Unavailable, FallbackValue=Unavailable}" Style="{StaticResource MetricText}" ToolTip="DIAGNOSTICS" />
            <TextBlock Text="{Binding Status.Coverage.NearEdgeCandidates, StringFormat=Near-edge: {0}, TargetNullValue=Near-edge: Unavailable, FallbackValue=Unavailable}" Style="{StaticResource MutedText}" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource WorkflowMetric}" MinWidth="150">
          <StackPanel>
            <TextBlock Text="CSV / ALERTS" Style="{StaticResource EyebrowText}" />
            <TextBlock Text="{Binding Status.CsvExportStatus, TargetNullValue=Unavailable, FallbackValue=Unavailable}" Style="{StaticResource MetricText}" />
            <TextBlock Text="{Binding Status.AlertsRaised, StringFormat=Alerts raised: {0}, TargetNullValue=Alerts unavailable, FallbackValue=Alerts unavailable}" Style="{StaticResource MutedText}" />
          </StackPanel>
        </Border>
      </WrapPanel>
      <Border Style="{StaticResource WorkflowCard}">
        <StackPanel>
          <Border Style="{StaticResource StatusBanner}" Tag="Info" Margin="0,0,0,10"><TextBlock Text="{Binding Status, Converter={StaticResource OperatorText}, ConverterParameter=Coverage}" TextWrapping="Wrap" AutomationProperties.AutomationId="MonitoringInputSummary" /></Border>
          <TextBlock Text="Coverage and output" Style="{StaticResource SectionTitleText}" Margin="0,0,0,10" />
          <WrapPanel>
            <Border Style="{StaticResource WorkflowMetric}">
              <StackPanel>
                <TextBlock Text="SKIPPED BY BOUND" Style="{StaticResource EyebrowText}" />
                <TextBlock Text="{Binding Status.Coverage.RelationshipsSkippedByBound, TargetNullValue=Unavailable, FallbackValue=Unavailable}" Style="{StaticResource MetricText}" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource WorkflowMetric}">
              <StackPanel>
                <TextBlock Text="PLANS BUILT" Style="{StaticResource EyebrowText}" />
                <TextBlock Text="{Binding Status.Coverage.PlansBuilt, TargetNullValue=Unavailable, FallbackValue=Unavailable}" Style="{StaticResource MetricText}" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource WorkflowMetric}">
              <StackPanel>
                <TextBlock Text="RESOLVED FEES" Style="{StaticResource EyebrowText}" />
                <TextBlock Text="{Binding Status.Coverage.PlansWithResolvedFees, TargetNullValue=Unavailable, FallbackValue=Unavailable}" Style="{StaticResource MetricText}" />
              </StackPanel>
            </Border>
          </WrapPanel>
          <TextBlock Text="{Binding Status.LastCsvErrorCode, StringFormat=CSV reason: {0}, TargetNullValue=CSV reason: None}" />
          <Expander Header="Full coverage diagnostics" Style="{StaticResource DetailsExpander}" Margin="0,8,0,0"><TextBlock Text="{Binding CoverageText}" TextWrapping="Wrap" /></Expander>
        </StackPanel>
      </Border>
      <Expander Header="Monitoring profile — save changes explicitly" Margin="0,4" Style="{StaticResource DetailsExpander}">
        <StackPanel>
          <TextBlock Text="Ranking thresholds and alert thresholds are independent. Default alerts require known fee-adjusted estimates. Kalshi public source conflicts remain gross-only. Manual trust is opt-in." TextWrapping="Wrap" />
          <WrapPanel Margin="0,6">
            <CheckBox Content="Include manual relationships" IsChecked="{Binding Profile.IncludeManualRelationships}" Margin="0,0,12,0" />
            <CheckBox Content="Fee-adjusted alerts" IsChecked="{Binding Profile.EnableFeeAdjustedAlerts}" Margin="0,0,12,0" />
            <CheckBox Content="GROSS / FEES UNRESOLVED alerts" IsChecked="{Binding Profile.EnableGrossOnlyAlerts}" Margin="0,0,12,0" />
            <CheckBox Content="Local CSV output" IsChecked="{Binding Profile.CsvEnabled}" />
          </WrapPanel>
          <WrapPanel x:Name="ProfileFields" />

        </StackPanel>
      </Expander>
      <Border Style="{StaticResource WorkflowCard}">
        <StackPanel>
          <TextBlock Text="Rankings filters" Style="{StaticResource SectionTitleText}" Margin="0,0,0,10" />
          <WrapPanel Margin="0,8">
            <TextBlock Text="Lane" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding Lanes}" SelectedItem="{Binding Lane}" Width="140" Margin="8,0" AutomationProperties.Name="Monitoring lane" />
            <TextBlock Text="Sort" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding Sorts}" SelectedItem="{Binding Sort}" Width="175" Margin="8,0" AutomationProperties.Name="Monitoring sort" />
          </WrapPanel>
          <WrapPanel Margin="0,0,0,8">
            <StackPanel>
              <TextBlock Text="Strategy" />
              <ComboBox ItemsSource="{Binding Strategies}" SelectedItem="{Binding Strategy}" Width="215" AutomationProperties.Name="Monitoring strategy" />
            </StackPanel>
            <StackPanel Margin="6,0">
              <TextBlock Text="Exchange" />
              <ComboBox ItemsSource="{Binding Exchanges}" SelectedItem="{Binding Exchange}" Width="115" AutomationProperties.Name="Monitoring exchange" />
            </StackPanel>
            <StackPanel>
              <TextBlock Text="Relationship trust" />
              <ComboBox ItemsSource="{Binding Trusts}" SelectedItem="{Binding Trust}" Width="125" AutomationProperties.Name="Monitoring relationship trust" />
            </StackPanel>
            <StackPanel Margin="6,0">
              <TextBlock Text="Input quality" />
              <ComboBox ItemsSource="{Binding Qualities}" SelectedItem="{Binding Quality}" Width="170" AutomationProperties.Name="Monitoring input quality" />
            </StackPanel>
            <StackPanel>
              <TextBlock Text="Fee status (blank = all)" />
              <TextBox Text="{Binding FeeStatus}" Width="185" AutomationProperties.Name="Fee status filter" ToolTip="Exact fee status, or blank for all. Applied on leaving the field." />
            </StackPanel>
          </WrapPanel>
          <TextBlock Text="Fee-adjusted and gross-only rows are separate lanes. Near-edge rows are not current arbitrage. Unknown fees are never zero." Style="{StaticResource MutedText}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource WorkflowCard}">
        <StackPanel>
          <TextBlock Text="Current rankings" Style="{StaticResource SectionTitleText}" Margin="0,0,0,10" />
          <TextBlock Text="CURRENT · latest backend ranking snapshot" Style="{StaticResource EyebrowText}" Margin="0,0,0,8" />
          <TextBlock Text="No current rankings returned for these filters." Tag="{Binding Items.Count}" Style="{StaticResource OperatorEmptyText}" />
          <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" AutomationProperties.Name="Current monitoring rankings" MaxHeight="230" MinHeight="100">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Rank" Binding="{Binding Rank}" Width="50" ElementStyle="{StaticResource WorkflowCellText}" />
              <DataGridTemplateColumn Header="Lane" Width="125">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <controls:StatusBadge Style="{StaticResource OperatorState}" Label="{Binding Lane}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Title" Binding="{Binding Opportunity.SourceTitle}" Width="220" ElementStyle="{StaticResource WorkflowCellText}" />
              <DataGridTextColumn Header="Trust" Binding="{Binding Opportunity.RelationshipTrust}" Width="90" ElementStyle="{StaticResource WorkflowEconomics}" />
              <DataGridTextColumn Header="Quantity" Binding="{Binding AvailableQuantity}" Width="85" ElementStyle="{StaticResource WorkflowCellText}" />
              <DataGridTextColumn Header="Gross profit" Binding="{Binding Opportunity.GrossProfit, TargetNullValue=Unknown}" Width="101" ElementStyle="{StaticResource WorkflowEconomics}" />
              <DataGridTextColumn Header="Gross edge" Binding="{Binding Opportunity.GrossEdgePerShare, TargetNullValue=Unknown}" Width="100" ElementStyle="{StaticResource WorkflowEconomics}" />
              <DataGridTextColumn Header="Fee-adjusted profit" Binding="{Binding Opportunity.Fees.FeeAdjustedGuaranteedProfit, TargetNullValue=Unknown, FallbackValue=Unknown}" Width="146" ElementStyle="{StaticResource WorkflowEconomics}" />
              <DataGridTextColumn Header="Fee-adjusted edge" Binding="{Binding Opportunity.Fees.FeeAdjustedEdgePerShare, TargetNullValue=Unknown, FallbackValue=Unknown}" Width="140" ElementStyle="{StaticResource WorkflowEconomics}" />
              <DataGridTextColumn Header="Fee status" Binding="{Binding Opportunity.Fees.StateLabel, TargetNullValue=Unknown, FallbackValue=Unknown}" Width="220" ElementStyle="{StaticResource WorkflowCellText}" />
              <DataGridTextColumn Header="Best edge" Binding="{Binding BestEdge, TargetNullValue=Unknown}" Width="95" ElementStyle="{StaticResource WorkflowCellText}" />
              <DataGridTextColumn Header="Required edge" Binding="{Binding RequiredEdge, TargetNullValue=Unknown}" Width="108" ElementStyle="{StaticResource WorkflowCellText}" />
              <DataGridTextColumn Header="Distance" Binding="{Binding Distance, TargetNullValue=Unknown}" Width="90" ElementStyle="{StaticResource WorkflowCellText}" />
              <DataGridTextColumn Header="Input quality" Binding="{Binding Opportunity.InputQuality}" Width="135" ElementStyle="{StaticResource WorkflowEconomics}" />
              <DataGridTextColumn Header="Skew ms" Binding="{Binding Opportunity.ObservedSkewMilliseconds, TargetNullValue=Unknown}" Width="85" ElementStyle="{StaticResource WorkflowCellText}" />
              <DataGridTextColumn Header="Updated UTC" Binding="{Binding Opportunity.EvaluatedAt}" Width="160" ElementStyle="{StaticResource WorkflowCellText}" />
              <DataGridTextColumn Header="Alert state" Binding="{Binding AlertState}" Width="100" ElementStyle="{StaticResource WorkflowCellText}" />
            </DataGrid.Columns>
          </DataGrid>
          <WrapPanel Margin="0,6">
            <Button Content="Previous" Command="{Binding PreviousCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,6" VerticalAlignment="Bottom" />
            <TextBlock Text="{Binding PageLabel}" Margin="12,0" VerticalAlignment="Center" />
            <Button Content="Next" Command="{Binding NextCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,6" VerticalAlignment="Bottom" />
          </WrapPanel>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource WorkflowCard}" AutomationProperties.AutomationId="HistoricalAlerts">
        <StackPanel>
          <TextBlock Text="Historical alerts — values at trigger time, not current opportunities" FontWeight="SemiBold" Margin="0,8" />
          <TextBlock Text="HISTORICAL · recorded at trigger time · inspect current separately" Style="{StaticResource MutedText}" Margin="0,0,0,8" />
          <TextBlock Text="No historical alerts returned." Tag="{Binding Alerts.Count}" Style="{StaticResource OperatorEmptyText}" />
          <DataGrid ItemsSource="{Binding Alerts}" SelectedItem="{Binding SelectedAlert}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" AutomationProperties.Name="Historical monitoring alerts" MaxHeight="140" MinHeight="100">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Triggered UTC" Binding="{Binding TriggeredAt}" Width="180" ElementStyle="{StaticResource WorkflowCellText}" />
              <DataGridTextColumn Header="Lane" Binding="{Binding Lane}" Width="100" ElementStyle="{StaticResource WorkflowCellText}" />
              <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="350" ElementStyle="{StaticResource WorkflowCellText}" />
              <DataGridTextColumn Header="Title at trigger" Binding="{Binding Opportunity.Opportunity.SourceTitle}" Width="250" ElementStyle="{StaticResource WorkflowCellText}" />
            </DataGrid.Columns>
          </DataGrid>
          <WrapPanel Margin="0,6">
            <Button Content="Previous alerts" Command="{Binding PreviousAlertsCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,6" VerticalAlignment="Bottom" />
            <TextBlock Text="{Binding AlertPageLabel}" Margin="12,0" VerticalAlignment="Center" />
            <Button Content="Next alerts" Command="{Binding NextAlertsCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,6" VerticalAlignment="Bottom" />
            <Button Content="Inspect current opportunity" Command="{Binding InspectAlertCommand}" Margin="0,0,8,6" Style="{StaticResource SecondaryButton}" VerticalAlignment="Bottom" />
          </WrapPanel>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource WorkflowCard}">
        <StackPanel>
          <TextBlock Text="Current opportunity inspector" Style="{StaticResource SectionTitleText}" Margin="0,0,0,10" />
          <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Margin="0,10" />
          <WrapPanel Margin="0,8">
            <Button Content="Paper preview…" Command="{Binding PaperPreviewCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,6" VerticalAlignment="Bottom" />
            <TextBlock Text="{Binding PaperReason}" Margin="8,0" VerticalAlignment="Center" />
          </WrapPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
